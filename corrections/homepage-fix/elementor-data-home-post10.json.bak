chip\" onclick=\"_H.chipSingle(this,\u0027skin_type\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Normal\u003c/button\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipSingle(this,\u0027skin_type\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Oily\u003c/button\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipSingle(this,\u0027skin_type\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Dry\u003c/button\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipSingle(this,\u0027skin_type\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Combination\u003c/button\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipSingle(this,\u0027skin_type\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Sensitive\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\r\n\u003cdiv class=\"f\"\u003e\u003clabel\u003ePrevious PMU?\u003c/label\u003e\u003cdiv class=\"chips\"\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipSingle(this,\u0027prev_pmu\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e No — first time\u003c/button\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipSingle(this,\u0027prev_pmu\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Yes — faded\u003c/button\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipSingle(this,\u0027prev_pmu\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Yes — still visible\u003c/button\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipSingle(this,\u0027prev_pmu\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Needs correction\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\r\n\u003cdiv class=\"f\"\u003e\u003clabel\u003eNotes / desired outcome\u003c/label\u003e\u003ctextarea id=\"p-pmu-notes\" style=\"min-height:60px\" placeholder=\"Desired look, inspiration references, concerns…\" maxlength=\"600\" autocomplete=\"off\" oninput=\"_H.autosave()\"\u003e\u003c/textarea\u003e\u003c/div\u003e\u003c/div\u003e`;\r\n\r\nvar PLACE_TATTOO_HTML=`\u003cdiv class=\"card\"\u003e\u003cdiv class=\"card-hd ct\"\u003eBody placement \u003cspan class=\"badge badge-g\"\u003eOPTIONAL — helps artist prepare\u003c/span\u003e\u003c/div\u003e\u003cdiv class=\"tap-hint\"\u003eTap body zones to mark placement. Tapped zones highlight. Tap again to deselect.\u003c/div\u003e\r\n\u003cdiv class=\"diag-wrap\"\u003e\r\n\u003cdiv class=\"diag-col\"\u003e\u003cdiv class=\"diag-lbl\"\u003eFront\u003c/div\u003e\r\n\u003csvg class=\"svg-diagram\" viewBox=\"0 0 120 270\" xmlns=\"http://www.w3.org/2000/svg\"\u003e\r\n\u003cline class=\"sk\" x1=\"60\" y1=\"38\" x2=\"60\" y2=\"110\"/\u003e\u003cpath class=\"sk\" d=\"M50,43 Q60,41 70,43\"/\u003e\u003cpath class=\"sk\" d=\"M47,104 Q60,110 73,104\"/\u003e\r\n\u003cellipse class=\"bz\" cx=\"60\" cy=\"20\" rx=\"15\" ry=\"17\" onclick=\"_H.zbp(this,\u0027Head\u0027,\u0027t\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"60\" y=\"21\"\u003eHEAD\u003c/text\u003e\r\n\u003crect class=\"bz\" x=\"54\" y=\"36\" width=\"12\" height=\"9\" rx=\"3\" onclick=\"_H.zbp(this,\u0027Neck\u0027,\u0027t\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"60\" y=\"42\"\u003eNECK\u003c/text\u003e\r\n\u003cellipse class=\"bz\" cx=\"27\" cy=\"49\" rx=\"11\" ry=\"9\" onclick=\"_H.zbp(this,\u0027L. Shoulder\u0027,\u0027t\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"27\" y=\"50\"\u003eL.SHLD\u003c/text\u003e\r\n\u003cellipse class=\"bz\" cx=\"93\" cy=\"49\" rx=\"11\" ry=\"9\" onclick=\"_H.zbp(this,\u0027R. Shoulder\u0027,\u0027t\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"93\" y=\"50\"\u003eR.SHLD\u003c/text\u003e\r\n\u003cpath class=\"bz\" d=\"M39,45 Q39,40 54,40 L54,71 Q46,71 38,64 Z\" onclick=\"_H.zbp(this,\u0027L. Chest\u0027,\u0027t\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"46\" y=\"58\"\u003eL.CHEST\u003c/text\u003e\r\n\u003cpath class=\"bz\" d=\"M81,45 Q81,40 66,40 L66,71 Q74,71 8