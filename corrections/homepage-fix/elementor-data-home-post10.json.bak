003cpath class=\"pz\" d=\"M45,120 Q54,117 73,120 Q72,131 60,134 Q48,131 45,120 Z\" onclick=\"_H.zbp(this,\u0027Labret/Ashley/Jestrum\u0027,\u0027p\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"59\" y=\"127\"\u003eLABRET\u003c/text\u003e\r\n\u003cellipse class=\"pz\" cx=\"32\" cy=\"126\" rx=\"10\" ry=\"7\" onclick=\"_H.zbp(this,\u0027L. Side Labret\u0027,\u0027p\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"32\" y=\"127\"\u003eL.SIDE\u003c/text\u003e\r\n\u003cellipse class=\"pz\" cx=\"88\" cy=\"126\" rx=\"10\" ry=\"7\" onclick=\"_H.zbp(this,\u0027R. Side Labret\u0027,\u0027p\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"88\" y=\"127\"\u003eR.SIDE\u003c/text\u003e\r\n\u003cpath class=\"pz\" d=\"M38,138 Q50,133 72,133 Q84,138 84,146 Q72,152 48,152 Q36,146 38,138 Z\" onclick=\"_H.zbp(this,\u0027Bites\u0027,\u0027p\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"61\" y=\"144\"\u003eBITES\u003c/text\u003e\r\n\u003cellipse class=\"pz\" cx=\"60\" cy=\"162\" rx=\"18\" ry=\"10\" onclick=\"_H.zbp(this,\u0027Tongue\u0027,\u0027p\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"60\" y=\"163\"\u003eTONGUE\u003c/text\u003e\r\n\u003ctext x=\"60\" y=\"192\" style=\"font-size:5px;fill:rgba(94,196,232,.18);text-anchor:middle\"\u003eFace · Magic Moon\u003c/text\u003e\r\n\u003c/svg\u003e\u003c/div\u003e\u003c/div\u003e\r\n\u003cdiv class=\"place-tags\" id=\"ptags-p\"\u003e\u003cspan class=\"place-note\"\u003eNo areas selected yet\u003c/span\u003e\u003c/div\u003e\r\n\u003cdiv class=\"cat-hd\" style=\"margin-top:12px\"\u003eSide preference\u003c/div\u003e\r\n\u003cdiv class=\"chips\"\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipSingle(this,\u0027pside\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Left\u003c/button\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipSingle(this,\u0027pside\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Right\u003c/button\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipSingle(this,\u0027pside\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Both\u003c/button\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipSingle(this,\u0027pside\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Centre / N/A\u003c/button\u003e\u003c/div\u003e\r\n\u003c/div\u003e`;\r\n\r\nvar PLACE_PMU_HTML=`\u003cdiv class=\"card\"\u003e\u003cdiv class=\"card-hd cm\"\u003eTreatment area \u003cspan class=\"badge badge-g\"\u003eOPTIONAL — tap to mark\u003c/span\u003e\u003c/div\u003e\u003cdiv class=\"tap-hint\"\u003eTap zones on the face and scalp diagrams to indicate your treatment area.\u003c/div\u003e\r\n\u003cdiv class=\"diag-wrap\"\u003e\r\n\u003cdiv class=\"diag-col\"\u003e\u003cdiv class=\"diag-lbl\" style=\"color:rgba(212,127,191,.6)\"\u003eFace — front\u003c/div\u003e\r\n\u003csvg class=\"svg-diagram\" viewBox=\"0 0 120 220\" style=\"max-width:155px\" xmlns=\"http://www.w3.org/2000/svg\"\u003e\r\n\u003cellipse class=\"sk\" cx=\"60\" cy=\"95\" rx=\"48\" ry=\"62\"/\u003e\r\n\u003cpath class=\"mz\" d=\"M16,57 Q36,28 60,26 Q84,28 104,57 Q91,50 60,48 Q29,50 16,57 Z\" onclick=\"_H.zbp(this,\u0027Scalp/Hairline\u0027,\u0027m\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"60\" y=\"44\"\u003eSCALP\u003c/text\u003e\r\n\u003cpath class=\"mz\" d=\"M24,60 Q42,50 60,50 Q78,50 96,60 Q91,71 60,73 Q29,71 24,60 Z\" onclick=\"_H.zbp(this,\u0027Forehead/Scar\u0027,\u0027m\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"60\" y=\"63\"\u003eFOREHEAD\u003c/text\u003e\r\n\u003cpath class=\"mz\" d=\"M18,72 Q29,62 47,65 Q48,75 36,78 Q23,77 18,72 Z\" onclick=\"_H.zbp(this,\u0027L. Brow\u0027,\u0027m\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"33\" y=\"72\"\u003eL.BROW\u003c/text\u003e\r\n\u003cpath class=\"mz\" d=\"M102,72 Q91,62 73,65 Q72,75 84,78 Q97,77 102,72 Z\" onclick=\"_H.zbp(this,\u0027R. Brow\u0027,\u0027m\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"87\" y=\"72\"\u003eR.BROW\u003c/text\u003e\r\n\u003cellipse class=\"mz\" cx=\"35\" cy=\"88\" rx=\"17\" ry=\"10\" onclick=\"_H.zbp(this,\u0027L. Eye/Lash Line\u0027,\u0027m\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"35\" y=\"89\"\u003eL.EYE\u003c/text\u003e\r\n\u003cellipse class=\"mz\" cx=\"85\" cy=\"88\" rx=\"17\" ry=\"10\" onclick=\"_H.zbp(this,\u0027R. Eye/Lash Line\u0027,\u0027m\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"85\" y=\"89\"\u003eR.EYE\u003c/text\u003e\r\n\u003cellipse class=\"mz\" cx=\"20\" cy=\"110\" rx=\"14\" ry=\"12\" onclick=\"_H.zbp(this,\u0027L. Cheek/Freckles\u0027,\u0027m\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"20\" y=\"111\"\u003eL.CHEEK\u003c/text\u003e\r\n\u003cellipse class=\"mz\" cx=\"100\" cy=\"110\" rx=\"14\" ry=\"12\" onclick=\"_H.zbp(this,\u0027R. Cheek/Freckles\u0027,\u0027m\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"100\" y=\"111\"\u003eR.CHEEK\u003c/text\u003e\r\n\u003cpath class=\"mz\" d=\"M52,116 Q60,110 68,116 Q65,124 60,126 Q55,124 52,116 Z\" onclick=\"_H.zbp(this,\u0027Philtrum\u0027,\u0027m\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"60\" y=\"119\"\u003ePHILTR.\u003c/text\u003e\r\n\u003cpath class=\"mz\" d=\"M34,126 Q46,117 60,119 Q74,117 86,126 Q82,142 60,146 Q38,142 34,126 Z\" onclick=\"_H.zbp(this,\u0027Lips\u0027,\u0027m\u0027)\"/\u003e\r\n\u003cline class=\"ml\" x1=\"34\" y1=\"132\" x2=\"86\" y2=\"132\"/\u003e\r\n\u003ctext class=\"bl\" x=\"60\" y=\"133\"\u003eLIPS\u003c/text\u003e\r\n\u003ctext x=\"60\" y=\"192\" style=\"font-size:5px;fill:rgba(212,127,191,.18);text-anchor:middle\"\u003eFace · Magic Moon\u003c/text\u003e\r\n\u003c/svg\u003e\u003c/div\u003e\r\n\u003cdiv class=\"diag-col\"\u003e\u003cdiv class=\"diag-lbl\" style=\"color:rgba(212,127,191,.6)\"\u003eScalp / Body\u003c/div\u003e\r\n\u003csvg class=\"svg-diagram\" viewBox=\"0 0 120 220\" style=\"max-width:155px\" xmlns=\"http://www.w3.org/2000/svg\"\u003e\r\n\u003cellipse class=\"sk\" cx=\"60\" cy=\"70\" rx=\"52\" ry=\"58\"/\u003e\r\n\u003cpath class=\"mz\" d=\"M13,52 Q35,20 60,18 Q85,20 107,52 Q94,45 60,43 Q26,45 13,52 Z\" onclick=\"_H.zbp(this,\u0027Hairline Reconstruction (SMP)\u0027,\u0027m\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"60\" y=\"39\"\u003eHAIRLINE\u003c/text\u003e\r\n\u003cellipse class=\"mz\" cx=\"17\" cy=\"65\" rx=\"14\" ry=\"17\" onclick=\"_H.zbp(this,\u0027L. Temple (SMP)\u0027,\u0027m\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"17\" y=\"66\"\u003eL.TEMP\u003c/text\u003e\r\n\u003cellipse class=\"mz\" cx=\"103\" cy=\"65\" rx=\"14\" ry=\"17\" onclick=\"_H.zbp(this,\u0027R. Temple (SMP)\u0027,\u0027m\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"103\" y=\"66\"\u003eR.TEMP\u003c/text\u003e\r\n\u003cellipse class=\"mz\" cx=\"60\" cy=\"70\" rx=\"32\" ry=\"28\" onclick=\"_H.zbp(this,\u0027Crown/Vertex (SMP)\u0027,\u0027m\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"60\" y=\"71\"\u003eCROWN\u003c/text\u003e\r\n\u003crect class=\"mz\" x=\"22\" y=\"142\" width=\"76\" height=\"32\" rx=\"6\" onclick=\"_H.zbp(this,\u0027Body Scar/Stretch Camouflage\u0027,\u0027m\u0027)\"/\u003e\r\n\u003ctext class=\"bl\" x=\"60\" y=\"156\"\u003eBODY\u003c/text\u003e\u003ctext class=\"bl\" x=\"60\" y=\"163\"\u003eCAMOUFLAGE\u003c/text\u003e\r\n\u003cellipse class=\"mz\" cx=\"60\" cy=\"196\" rx=\"28\" ry=\"16\" onclick=\"_H.zbp(this,\u0027Areola Restoration\u0027,\u0027m\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"60\" y=\"197\"\u003eAREOLA\u003c/text\u003e\r\n\u003ctext x=\"60\" y=\"215\" style=\"font-size:5px;fill:rgba(212,127,191,.18);text-anchor:middle\"\u003eScalp/Body · Magic Moon\u003c/text\u003e\r\n\u003c/svg\u003e\u003c/div\u003e\u003c/div\u003e\r\n\u003cdiv class=\"place-tags\" id=\"ptags-m\"\u003e\u003cspan class=\"place-note\"\u003eNo areas selected yet\u003c/span\u003e\u003c/div\u003e\r\n\u003c/div\u003e`;\r\n\r\n/* ═══════════════════════════════════════════════════════\r\n   CUSTOM CALENDAR ENGINE\r\n   Handles two calendars: \u0027dob\u0027 (past dates, DOB)\r\n                          \u0027appt\u0027 (future dates, appointment)\r\n   Each has a trigger button, a popup, a hidden input.\r\n   Mode: \u0027days\u0027 | \u0027months\u0027 | \u0027years\u0027\r\n═══════════════════════════════════════════════════════ */\r\nvar CAL = {\r\n  open: null,          /* which calendar is open: \u0027dob\u0027|\u0027appt\u0027|null */\r\n  mode: \u0027days\u0027,        /* days | months | years */\r\n  viewYear: 2000,\r\n  viewMonth: 0,        /* 0-11 */\r\n  selDate: { dob:null, appt:null } /* {y,m,d} or null */\r\n};\r\nvar MONTHS = [\u0027January\u0027,\u0027February\u0027,\u0027March\u0027,\u0027April\u0027,\u0027May\u0027,\u0027June\u0027,\r\n              \u0027July\u0027,\u0027August\u0027,\u0027September\u0027,\u0027October\u0027,\u0027November\u0027,\u0027December\u0027];\r\nvar DAYS   = [\u0027Su\u0027,\u0027Mo\u0027,\u0027Tu\u0027,\u0027We\u0027,\u0027Th\u0027,\u0027Fr\u0027,\u0027Sa\u0027];\r\n\r\nfunction openCal(which){\r\n  var other = which===\u0027dob\u0027?\u0027appt\u0027:\u0027dob\u0027;\r\n  /* Close other if open */\r\n  closeCal(other);\r\n  /* If this one is already open, close it */\r\n  if(CAL.open===which){ closeCal(which); return; }\r\n  CAL.open = which;\r\n  CAL.mode = \u0027days\u0027;\r\n  /* Initialise view to selected date or sensible default */\r\n  var now = new Date();\r\n  if(CAL.selDate[which]){\r\n    CAL.viewYear  = CAL.selDate[which].y;\r\n    CAL.viewMonth = CAL.selDate[which].m;\r\n  } else if(which===\u0027dob\u0027){\r\n    CAL.viewYear  = now.getFullYear()-25;\r\n    CAL.viewMonth = now.getMonth();\r\n  } else {\r\n    CAL.viewYear  = now.getFullYear();\r\n    CAL.viewMonth = now.getMonth();\r\n  }\r\n  renderCal(which);\r\n  var popup=$(\u0027cal-popup-\u0027+which);\r\n  if(popup) popup.classList.remove(\u0027hidden\u0027);\r\n}\r\nfunction closeCal(which){\r\n  var popup=$(\u0027cal-popup-\u0027+which);\r\n  if(popup) popup.classList.add(\u0027hidden\u0027);\r\n  if(CAL.open===which) CAL.open=null;\r\n}\r\nfunction renderCal(which){\r\n  var popup=$(\u0027cal-popup-\u0027+which);\r\n  if(!popup) return;\r\n  /* Clear */\r\n  while(popup.firstChild) popup.removeChild(popup.firstChild);\r\n  if(CAL.mode===\u0027days\u0027)   renderCalDays(popup, which);\r\n  if(CAL.mode===\u0027months\u0027) renderCalMonths(popup, which);\r\n  if(CAL.mode===\u0027years\u0027)  renderCalYears(popup, which);\r\n}\r\n\r\nfunction renderCalDays(popup, which){\r\n  var now  = new Date();\r\n  var isDob = which===\u0027dob\u0027;\r\n  var head = document.createElement(\u0027div\u0027); head.className=\u0027cal-head\u0027;\r\n  /* Prev arrow */\r\n  var prev = document.createElement(\u0027button\u0027); prev.type=\u0027button\u0027;\r\n  prev.className=\u0027cal-nav\u0027; prev.textContent=\u0027‹\u0027;\r\n  prev.addEventListener(\u0027click\u0027,function(e){ e.stopPropagation(); CAL.viewMonth--; if(CAL.viewMonth\u003c0){CAL.viewMonth=11;CAL.viewYear--;} renderCal(which); });\r\n  /* Title — click to go to month picker */\r\n  var title = document.createElement(\u0027div\u0027); title.className=\u0027cal-head-title\u0027;\r\n  title.textContent = MONTHS[CAL.viewMonth]+\u0027 \u0027+CAL.viewYear;\r\n  title.addEventListener(\u0027click\u0027,function(e){ e.stopPropagation(); CAL.mode=\u0027months\u0027; renderCal(which); });\r\n  /* Next arrow */\r\n  var next = document.createElement(\u0027button\u0027); next.type=\u0027button\u0027;\r\n  next.className=\u0027cal-nav\u0027; next.textContent=\u0027›\u0027;\r\n  next.addEventListener(\u0027click\u0027,function(e){ e.stopPropagation(); CAL.viewMonth++; if(CAL.viewMonth\u003e11){CAL.viewMonth=0;CAL.viewYear++;} renderCal(which); });\r\n  head.appendChild(prev); head.appendChild(title); head.appendChild(next);\r\n  /* DOW row */\r\n  var dow = document.createElement(\u0027div\u0027); dow.className=\u0027cal-dow\u0027;\r\n  DAYS.forEach(function(d){ var s=document.createElement(\u0027span\u0027); s.textContent=d; dow.appendChild(s); });\r\n  /* Days grid */\r\n  var grid = document.createElement(\u0027div\u0027); grid.className=\u0027cal-days\u0027;\r\n  var first = new Date(CAL.viewYear, CAL.viewMonth, 1).getDay(); // 0=Sun\r\n  var daysInMonth = new Date(CAL.viewYear, CAL.viewMonth+1, 0).getDate();\r\n  /* Empty cells before first day */\r\n  for(var i=0;i\u003cfirst;i++){\r\n    var empty=document.createElement(\u0027div\u0027); empty.className=\u0027cal-day cal-empty\u0027; grid.appendChild(empty);\r\n  }\r\n  for(var d=1;d\u003c=daysInMonth;d++){\r\n    (function(day){\r\n      var cell=document.createElement(\u0027div\u0027); cell.className=\u0027cal-day\u0027;\r\n      cell.textContent=day;\r\n      var thisDate = new Date(CAL.viewYear, CAL.viewMonth, day);\r\n      /* Today marker */\r\n      if(thisDate.toDateString()===now.toDateString()) cell.classList.add(\u0027cal-today\u0027);\r\n      /* Disable future dates for DOB */\r\n      if(isDob \u0026\u0026 thisDate \u003e now) cell.classList.add(\u0027cal-disabled\u0027);\r\n      /* Disable past dates for appointment */\r\n      if(!isDob){\r\n        var today = new Date(now.getFullYear(),now.getMonth(),now.getDate());\r\n        if(thisDate \u003c today) cell.classList.add(\u0027cal-disabled\u0027);\r\n      }\r\n      /* Selected */\r\n      var sel=CAL.selDate[which];\r\n      if(sel \u0026\u0026 sel.y===CAL.viewYear \u0026\u0026 sel.m===CAL.viewMonth \u0026\u0026 sel.d===day) cell.classList.add(\u0027cal-sel\u0027);\r\n      if(!cell.classList.contains(\u0027cal-disabled\u0027)){\r\n        cell.addEventListener(\u0027click\u0027,function(e){\r\n          e.stopPropagation();\r\n          CAL.selDate[which]={y:CAL.viewYear, m:CAL.viewMonth, d:day};\r\n          selectCalDate(which);\r\n        });\r\n      }\r\n      grid.appendChild(cell);\r\n    })(d);\r\n  }\r\n  /* Footer */\r\n  var foot = document.createElement(\u0027div\u0027); foot.className=\u0027cal-footer\u0027;\r\n  var todayBtn = document.createElement(\u0027button\u0027); todayBtn.type=\u0027button\u0027;\r\n  todayBtn.className=\u0027cal-today-btn\u0027;\r\n  todayBtn.textContent = isDob ? \u0027Jump to today\u0027 : \u0027Today\u0027;\r\n  todayBtn.addEventListener(\u0027click\u0027,function(e){\r\n    e.stopPropagation();\r\n    CAL.viewYear=now.getFullYear(); CAL.viewMonth=now.getMonth();\r\n    CAL.mode=\u0027days\u0027; renderCal(which);\r\n  });\r\n  var clearBtn = document.createElement(\u0027button\u0027); clearBtn.type=\u0027button\u0027;\r\n  clearBtn.className=\u0027cal-clear-btn\u0027; clearBtn.textContent=\u0027Clear\u0027;\r\n  clearBtn.addEventListener(\u0027click\u0027,function(e){\r\n    e.stopPropagation(); clearCalDate(which);\r\n  });\r\n  foot.appendChild(todayBtn); foot.appendChild(clearBtn);\r\n  popup.appendChild(head); popup.appendChild(dow); popup.appendChild(grid); popup.appendChild(foot);\r\n}\r\n\r\nfunction renderCalMonths(popup, which){\r\n  var head = document.createElement(\u0027div\u0027); head.className=\u0027cal-head\u0027;\r\n  var prev = document.createElement(\u0027button\u0027); prev.type=\u0027button\u0027; prev.className=\u0027cal-nav\u0027; prev.textContent=\u0027‹\u0027;\r\n  prev.addEventListener(\u0027click\u0027,function(e){ e.stopPropagation(); CAL.viewYear--; renderCal(which); });\r\n  var title = document.createElement(\u0027div\u0027); title.className=\u0027cal-head-title\u0027;\r\n  title.textContent=String(CAL.viewYear);\r\n  title.addEventListener(\u0027click\u0027,function(e){ e.stopPropagation(); CAL.mode=\u0027years\u0027; renderCal(which); });\r\n  var next = document.createElement(\u0027button\u0027); next.type=\u0027button\u0027; next.className=\u0027cal-nav\u0027; next.textContent=\u0027›\u0027;\r\n  next.addEventListener(\u0027click\u0027,function(e){ e.stopPropagation(); CAL.viewYear++; renderCal(which); });\r\n  head.appendChild(prev); head.appendChild(title); head.appendChild(next);\r\n  var grid = document.createElement(\u0027div\u0027); grid.className=\u0027cal-ym-grid\u0027;\r\n  MONTHS.forEach(function(mName,mi){\r\n    (function(idx){\r\n      var item=document.createElement(\u0027div\u0027); item.className=\u0027cal-ym-item\u0027;\r\n      item.textContent=mName.substring(0,3);\r\n      var sel=CAL.selDate[which];\r\n      if(sel \u0026\u0026 sel.m===idx \u0026\u0026 sel.y===CAL.viewYear) item.classList.add(\u0027sel\u0027);\r\n      item.addEventListener(\u0027click\u0027,function(e){\r\n        e.stopPropagation(); CAL.viewMonth=idx; CAL.mode=\u0027days\u0027; renderCal(which);\r\n      });\r\n      grid.appendChild(item);\r\n    })(mi);\r\n  });\r\n  popup.appendChild(head); popup.appendChild(grid);\r\n}\r\n\r\nfunction renderCalYears(popup, which){\r\n  var base = Math.floor(CAL.viewYear/10)*10;\r\n  var head = document.createElement(\u0027div\u0027); head.className=\u0027cal-head\u0027;\r\n  var prev=document.createElement(\u0027button\u0027); prev.type=\u0027button\u0027; prev.className=\u0027cal-nav\u0027; prev.textContent=\u0027‹\u0027;\r\n  prev.addEventListener(\u0027click\u0027,function(e){ e.stopPropagation(); CAL.viewYear-=10; renderCal(which); });\r\n  var title=document.createElement(\u0027div\u0027); title.className=\u0027cal-head-title\u0027;\r\n  title.textContent=base+\u0027 – \u0027+(base+9);\r\n  var next=document.createElement(\u0027button\u0027); next.type=\u0027button\u0027; next.className=\u0027cal-nav\u0027; next.textContent=\u0027›\u0027;\r\n  next.addEventListener(\u0027click\u0027,function(e){ e.stopPropagation(); CAL.viewYear+=10; renderCal(which); });\r\n  head.appendChild(prev); head.appendChild(title); head.appendChild(next);\r\n  var grid=document.createElement(\u0027div\u0027); grid.className=\u0027cal-ym-grid\u0027;\r\n  for(var y=base;y\u003cbase+10;y++){\r\n    (function(yr){\r\n      var item=document.createElement(\u0027div\u0027); item.className=\u0027cal-ym-item\u0027;\r\n      item.textContent=yr;\r\n      var sel=CAL.selDate[which];\r\n      if(sel \u0026\u0026 sel.y===yr) item.classList.add(\u0027sel\u0027);\r\n      item.addEventListener(\u0027click\u0027,function(e){\r\n        e.stopPropagation(); CAL.viewYear=yr; CAL.mode=\u0027months\u0027; renderCal(which);\r\n      });\r\n      grid.appendChild(item);\r\n    })(y);\r\n  }\r\n  popup.appendChild(head); popup.appendChild(grid);\r\n}\r\n\r\nfunction selectCalDate(which){\r\n  var sel=CAL.selDate[which];\r\n  if(!sel) return;\r\n  /* ISO string for hidden input */\r\n  var mm=String(sel.m+1).padStart(2,\u00270\u0027), dd=String(sel.d).padStart(2,\u00270\u0027);\r\n  var iso=sel.y+\u0027-\u0027+mm+\u0027-\u0027+dd;\r\n  /* Display string for trigger button */\r\n  var display=sel.d+\u0027 \u0027+MONTHS[sel.m]+\u0027 \u0027+sel.y;\r\n  var hiddenId  = which===\u0027dob\u0027 ? \u0027p-dob\u0027       : \u0027p-date\u0027;\r\n  var triggerId = which===\u0027dob\u0027 ? \u0027dob-trigger\u0027  : \u0027appt-trigger\u0027;\r\n  var displayId = which===\u0027dob\u0027 ? \u0027dob-display\u0027  : \u0027appt-display\u0027;\r\n  var hidden=$(hiddenId), trig=$(triggerId), disp=$(displayId);\r\n  if(hidden) hidden.value=iso;\r\n  if(trig){ trig.classList.remove(\u0027inv\u0027); trig.classList.add(\u0027ok\u0027); }\r\n  if(disp){ disp.textContent=display; disp.classList.remove(\u0027cal-placeholder\u0027); }\r\n  closeCal(which);\r\n  autosave();\r\n}\r\nfunction clearCalDate(which){\r\n  CAL.selDate[which]=null;\r\n  var hiddenId  = which===\u0027dob\u0027 ? \u0027p-dob\u0027      : \u0027p-date\u0027;\r\n  var triggerId = which===\u0027dob\u0027 ? \u0027dob-trigger\u0027 : \u0027appt-trigger\u0027;\r\n  var displayId = which===\u0027dob\u0027 ? \u0027dob-display\u0027 : \u0027appt-display\u0027;\r\n  var hidden=$(hiddenId), trig=$(triggerId), disp=$(displayId);\r\n  if(hidden) hidden.value=\u0027\u0027;\r\n  if(trig){ trig.classList.remove(\u0027ok\u0027,\u0027inv\u0027); }\r\n  if(disp){ disp.textContent=which===\u0027dob\u0027?\u0027Select date of birth\u0027:\u0027Select preferred date\u0027; disp.classList.add(\u0027cal-placeholder\u0027); }\r\n  renderCal(which);\r\n  autosave();\r\n}\r\n/* Close calendar when clicking outside */\r\ndocument.addEventListener(\u0027click\u0027, function(e){\r\n  if(!CAL.open) return;\r\n  var popupId=\u0027cal-popup-\u0027+CAL.open;\r\n  var popup=$(popupId);\r\n  var triggerId=(CAL.open===\u0027dob\u0027?\u0027dob-trigger\u0027:\u0027appt-trigger\u0027);\r\n  var trigger=$(triggerId);\r\n  if(popup\u0026\u0026!popup.contains(e.target)\u0026\u0026trigger\u0026\u0026!trigger.contains(e.target)){\r\n    closeCal(CAL.open);\r\n  }\r\n});\r\n\r\n/* ═══ PUBLIC API — frozen (prevents external tampering) ═══ */\r\nwindow.F = Object.freeze({\r\n  setMode:setMode, pickSvc:pickSvc, go:go,\r\n  pickConsult:pickConsult, pickSlot:pickSlot,\r\n  handleFile:handleFile, submit:submit, submitWI:submitWI,\r\n  generatePDF:generatePDF,\r\n  livePhone:livePhone, liveZip:liveZip, onCountryChange:onCountryChange\r\n});\r\n/* Helpers called from static HTML strings — must be global */\r\n/* ── Static-HTML helpers — grouped in frozen _H object.\r\n   These must be accessible from inline onclick in developer-authored\r\n   static HTML strings (TATTOO_HTML etc). They are NOT user-data sinks.\r\n   Grouping prevents external scripts from calling them individually. ── */\r\nwindow._H = Object.freeze({\r\n  showCat    : showCat,\r\n  chipSingle : chipSingle,\r\n  chipOther  : chipOther,\r\n  chipMulti  : chipMulti,\r\n  zbp        : zbp,\r\n  autosave   : autosave,\r\n  openCal    : openCal\r\n});\r\n\r\n/* ═══ INIT ═══ */\r\n(function init(){\r\n  /* Note: date constraints are enforced inside the calendar engine, not via HTML min.\r\n     DOB: disables future dates. Appointment: disables past dates. */\r\n  var af = $(\u0027artist-field\u0027); if(af) af.style.display=\u0027none\u0027;\r\n  attachAutosave();\r\n  restoreAutosave();\r\n})();\r\n\r\n})();\r\n\u003c/script\u003e\r\n\u003c/body\u003e\r\n\u003c/html\u003e","pa_condition_repeater":[],"ha_cmc_text":"Happy Addons"},"elements":[],"widgetType":"html"}],"isInner":true}],"isInner":false},{"id":"4f41471","elType":"container","settings":{"flex_directio