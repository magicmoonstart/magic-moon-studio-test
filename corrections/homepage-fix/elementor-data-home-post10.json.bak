e":28,"sizes":[]},"_element_width":"initial","_element_custom_width":{"unit":"%","size":48,"sizes":[]},"__globals__":{"title_color":"globals/colors?id=7444022"},"ha_cmc_text":"Happy Addons","pa_condition_repeater":[]},"elements":[],"widgetType":"heading"},{"id":"58e90a8","elType":"widget","settings":{"title":"Email","typography_typography":"custom","typography_font_family":"Inter","typography_font_size":{"unit":"px","size":20,"sizes":[]},"typography_font_weight":"500","__globals__":{"title_color":"globals/colors?id=f6d4a8e"},"ha_cmc_text":"Happy Addons","pa_condition_repeater":[]},"elements":[],"widgetType":"heading"},{"id":"bb03873","elType":"widget","settings":{"title":"studio@magic-moon.de","typography_typography":"custom","typography_font_family":"Inter","typography_font_size":{"unit":"px","size":20,"sizes":[]},"typography_font_weight":"500","__globals__":{"title_color":"globals/colors?id=7444022"},"ha_cmc_text":"Happy Addons","pa_condition_repeater":[]},"elements":[],"widgetType":"heading"}],"isInner":true},{"id":"6282cdf","elType":"container","settings":{"flex_direction":"column","content_width":"full","width":{"unit":"%","size":"50"},"background_background":"classic","background_color":"#2F2122","margin_mobile":{"unit":"px","top":"40","right":"0","bottom":"0","left":"0","isLinked":false},"padding":{"unit":"px","top":"60","right":"0","bottom":"100","left":"20","isLinked":false},"ha_cmc_text":"Happy Addons","hover_parallax":[{"layer_position_vr":{"unit":"%","size":30},"layer_position_hr":{"unit":"%","size":40},"_id":"5dfb369"},{"layer_position_vr":{"unit":"%","size":60},"layer_position_hr":{"unit":"%","size":20},"_id":"1b40cb5"}],"pa_condition_repeater":[],"padding_mobile":{"unit":"px","top":"10","right":"10","bottom":"10","left":"10","isLinked":true},"custom_css":"selector{\n    overflow: hidden !important\n    ;\n}","flex_justify_content":"center"},"elements":[{"id":"acfaba5","elType":"widget","settings":{"html":"\u003c!DOCTYPE html\u003e\r\n\u003chtml lang=\"en\"\u003e\r\n\u003chead\u003e\r\n\u003cmeta charset=\"UTF-8\"\u003e\r\n\u003cmeta name=\"viewport\" content=\"width=device-width,initial-scale=1\"\u003e\r\n\u003c!--\r\n  SECURITY HARDENED — Content Security Policy\r\n  Allows: self scripts, Google Fonts, Cloudflare CDN (jsPDF lazy)\r\n  Blocks: inline event handlers injected dynamically, data: URIs for scripts\r\n--\u003e\r\n\u003cmeta http-equiv=\"Content-Security-Policy\"\r\n  content=\"default-src \u0027self\u0027;\r\n           script-src \u0027self\u0027 \u0027unsafe-inline\u0027 https://cdnjs.cloudflare.com;\r\n           style-src  \u0027self\u0027 \u0027unsafe-inline\u0027 https://fonts.googleapis.com;\r\n           font-src   https://fonts.gstatic.com;\r\n           img-src    \u0027self\u0027 data: blob:;\r\n           connect-src \u0027none\u0027;\"\u003e\r\n\u003clink rel=\"preconnect\" href=\"https://fonts.googleapis.com\"\u003e\r\n\u003clink rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin\u003e\r\n\u003clink href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue\u0026family=DM+Sans:wght@300;400;500;600\u0026display=swap\" rel=\"stylesheet\"\u003e\r\n\u003ctitle\u003eTattooing Erkelenz — Book Consultation\u003c/title\u003e\r\n\u003cstyle\u003e\r\n/* ── base reset ── */\r\n*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\r\n:root{\r\n  --g:#c8a96e;--g2:#e8d5a8;--g3:rgba(200,169,110,.1);\r\n  --bg:#0c0c0c;--s1:#141210;--s2:#1c1916;\r\n  --bdr:rgba(200,169,110,.2);--bdr2:rgba(200,169,110,.45);\r\n  --inp:rgba(255,255,255,.055);--tx:#ede8e0;--txm:rgba(237,232,224,.5);\r\n  --txd:rgba(237,232,224,.28);--red:#e24b4a;--grn:#4a8c2a;\r\n  --hov:#e8c97a;   /* warm amber gold — positive, readable, on-brand */\r\n  --hov2:#f5dfa0;  /* lighter gold highlight for text on hover */\r\n  --ct:#c8a96e;--cp:#5ec4e8;--cm:#d47fbf;\r\n}\r\nbody{background:var(--bg);color:var(--tx);font-family:\u0027DM Sans\u0027,sans-serif;min-height:100vh}\r\n.tmf{max-width:740px;margin:0 auto;padding:0 0 5rem}\r\n.tmf-hdr{padding:1.5rem 1.25rem 1.1rem;border-bottom:1px solid var(--bdr);display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:1.5rem}\r\n.brand-name{font-family:\u0027Bebas Neue\u0027,sans-serif;font-size:1.9rem;letter-spacing:.12em;color:var(--g);line-height:1}\r\n.brand-sub{font-size:10px;color:var(--txm);letter-spacing:.1em;margin-top:3px;text-transform:uppercase}\r\n.hdr-r{font-size:10.5px;color:var(--txm);text-align:right;line-height:1.7}\r\n.prog-wrap{padding:0 1.25rem;margin-bottom:1.5rem}\r\n.prog-bars{display:flex;gap:5px;margin-bottom:7px}\r\n.pb{flex:1;height:3px;border-radius:2px;background:var(--s2);transition:background .35s}\r\n.pb.done,.pb.act{background:var(--g)}.pb.act{opacity:.55}\r\n.prog-txt{display:flex;justify-content:space-between;font-size:11px}\r\n.prog-step{color:var(--g);font-weight:500}.prog-name{color:var(--txm)}\r\n.autosave-bar{font-size:10px;color:var(--txm);text-align:right;padding:0 1.25rem 6px;display:none;align-items:center;justify-content:flex-end;gap:5px}\r\n.autosave-bar .dot{width:6px;height:6px;border-radius:50%;background:var(--grn);display:inline-block}\r\n.sec{padding:0 1.25rem}\r\n.step{display:none}.step.active{display:block}\r\n.mode-tabs{display:flex;border:1px solid var(--bdr);border-radius:8px;overflow:hidden;margin-bottom:1.25rem}\r\n.mode-tab{flex:1;padding:.65rem;text-align:center;cursor:pointer;font-size:13px;font-weight:500;background:transparent;border:none;color:var(--txm);transition:all .2s;font-family:\u0027DM Sans\u0027,sans-serif}\r\n.mode-tab:hover{color:var(--hov);background:rgba(232,201,122,.06)}.mode-tab.on{background:var(--g);color:#111;font-weight:600}\r\n.mode-tab:first-child{border-right:1px solid var(--bdr)}\r\n.card{background:var(--s1);border:1px solid var(--bdr);border-radius:12px;padding:1.25rem;margin-bottom:.85rem;transition:border-color .2s}\r\n.card:focus-within{border-color:var(--bdr2)}\r\n.card:hover{border-color:rgba(232,201,122,.3)}\r\n.card-hd{font-family:\u0027Bebas Neue\u0027,sans-serif;font-size:.9rem;letter-spacing:.1em;color:var(--g);margin-bottom:.8rem;display:flex;align-items:center;gap:8px;flex-wrap:wrap}\r\n.card-hd.ct{color:var(--ct)}.card-hd.cp{color:var(--cp)}.card-hd.cm{color:var(--cm)}\r\n.badge{font-size:8.5px;padding:2px 7px;border-radius:3px;font-weight:600;letter-spacing:.05em;font-family:\u0027DM Sans\u0027,sans-serif}\r\n.badge-r{background:rgba(226,75,74,.12);border:1px solid rgba(226,75,74,.28);color:var(--red)}\r\n.badge-o{background:rgba(200,169,110,.1);border:1px solid var(--bdr);color:var(--g)}\r\n.badge-g{background:rgba(74,140,42,.1);border:1px solid rgba(74,140,42,.3);color:#7dc46a}\r\n.f{margin-bottom:.8rem}\r\n.f label{display:block;font-size:11px;letter-spacing:.06em;color:var(--txm);margin-bottom:5px;text-transform:uppercase}\r\n.rstar{color:var(--red);margin-left:2px}\r\n.f input,.f select,.f textarea{width:100%;background:var(--inp);border:1px solid var(--bdr);border-radius:7px;padding:10px 12px;font-family:\u0027DM Sans\u0027,sans-serif;font-size:14px;color:var(--tx);outline:none;transition:border-color .2s,background .2s;min-height:42px}\r\n.f input:focus,.f select:focus,.f textarea:focus{border-color:var(--g);background:rgba(200,169,110,.03)}\r\n.f input:hover,.f select:hover{border-color:rgba(232,201,122,.45)}\r\n.f input::placeholder,.f textarea::placeholder{color:var(--txd)}\r\n.f select option{background:#1a1713;color:var(--tx)}\r\n.f textarea{resize:vertical;min-height:70px;line-height:1.6}\r\n.f input.inv,.f select.inv,.f textarea.inv{border-color:var(--red)!important}\r\n.f input.ok{border-color:var(--grn)!important}\r\n.g2{display:grid;grid-template-columns:1fr 1fr;gap:10px}\r\n.errmsg{font-size:11px;color:var(--red);margin-top:4px;display:none}\r\n.errmsg.show{display:block}\r\n.okmsg{font-size:11px;color:var(--grn);margin-top:3px;display:none}\r\n.okmsg.show{display:block}\r\n.hint{font-size:11.5px;color:var(--txm);line-height:1.6;margin-bottom:10px}\r\n/* country + zip row */\r\n.zip-row{display:grid;grid-template-columns:140px 1fr;gap:10px}\r\n/* service cards */\r\n.svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:1rem}\r\n.svc-card{border:1.5px solid var(--bdr);border-radius:10px;padding:1rem .75rem;text-align:center;cursor:pointer;background:var(--s1);transition:all .22s;position:relative}\r\n.svc-card:hover{border-color:var(--hov);background:rgba(232,201,122,.04)}\r\n.svc-card .ico{font-size:1.6rem;display:block;margin-bottom:5px}\r\n.svc-card .sn{font-family:\u0027Bebas Neue\u0027,sans-serif;font-size:.95rem;letter-spacing:.1em;display:block;margin-bottom:2px}\r\n.svc-card .ss{font-size:10px;color:var(--txm);line-height:1.4}\r\n.svc-card .ck{position:absolute;top:6px;right:6px;width:18px;height:18px;border-radius:50%;display:none;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#111}\r\n.svc-card.sel-t{border-color:var(--ct);background:rgba(200,169,110,.07)}.svc-card.sel-t .sn{color:var(--ct)}.svc-card.sel-t .ck{background:var(--ct);display:flex}\r\n.svc-card.sel-p{border-color:var(--cp);background:rgba(94,196,232,.06)}.svc-card.sel-p .sn{color:var(--cp)}.svc-card.sel-p .ck{background:var(--cp);display:flex}\r\n.svc-card.sel-m{border-color:var(--cm);background:rgba(212,127,191,.06)}.svc-card.sel-m .sn{color:var(--cm)}.svc-card.sel-m .ck{background:var(--cm);display:flex}\r\n/* chips */\r\n.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:5px}\r\n.chip{padding:7px 14px;min-height:36px;border:1px solid var(--bdr);border-radius:20px;background:transparent;color:var(--txm);font-family:\u0027DM Sans\u0027,sans-serif;font-size:12.5px;cursor:pointer;transition:all .18s;white-space:nowrap;display:inline-flex;align-items:center;gap:5px}\r\n.chip:hover{border-color:var(--hov);color:var(--hov);background:rgba(232,201,122,.06)}\r\n.chip.on{border-color:var(--g);background:var(--g3);color:var(--g);font-weight:500}\r\n.chip.on-p{border-color:var(--cp);background:rgba(94,196,232,.1);color:var(--cp);font-weight:500}\r\n.chip.on-m{border-color:var(--cm);background:rgba(212,127,191,.1);color:var(--cm);font-weight:500}\r\n.chip .ck2{font-size:10px;display:none}\r\n.chip.on .ck2,.chip.on-p .ck2,.chip.on-m .ck2{display:inline}\r\n.cat-hd{font-size:10px;letter-spacing:.08em;color:var(--txm);text-transform:uppercase;margin:12px 0 6px;padding-bottom:4px;border-bottom:1px solid var(--bdr)}\r\n/* style categories */\r\n.scat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:10px}\r\n.scat-btn{border:1px solid var(--bdr);border-radius:8px;padding:.6rem .4rem;text-align:center;cursor:pointer;background:var(--s2);transition:all .2s}\r\n.scat-btn:hover{border-color:var(--hov);background:rgba(232,201,122,.05)}\r\n.scat-btn.act{border-color:var(--g);background:var(--g3)}\r\n.scat-btn .si{font-size:1.1rem;display:block;margin-bottom:3px}\r\n.scat-btn .sl{font-size:10px;color:var(--txm);line-height:1.3}\r\n.scat-btn.act .sl{color:var(--g)}\r\n.style-panel{display:none;animation:fade .18s ease}\r\n.style-panel.show{display:block}\r\n@keyframes fade{from{opacity:0;transform:translateY(-3px)}to{opacity:1;transform:none}}\r\n.reveal{max-height:0;overflow:hidden;transition:max-height .28s ease,opacity .2s;opacity:0}\r\n.reveal.open{max-height:90px;opacity:1;margin-top:8px}\r\n.reveal input{width:100%;background:var(--inp);border:1px solid var(--bdr);border-radius:7px;padding:9px 12px;font-family:\u0027DM Sans\u0027,sans-serif;font-size:13px;color:var(--tx);outline:none;transition:border-color .2s}\r\n.reveal input:focus{border-color:var(--g)}\r\n/* SVG zones */\r\n.diag-wrap{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:10px}\r\n.diag-col{display:flex;flex-direction:column;align-items:center}\r\n.diag-lbl{font-size:9px;letter-spacing:.1em;color:var(--txm);text-transform:uppercase;margin-bottom:5px}\r\n.svg-diagram{width:100%;max-width:155px;overflow:visible}\r\n.bz{fill:rgba(200,169,110,.1);stroke:rgba(200,169,110,.45);stroke-width:1;cursor:pointer;transition:fill .18s,stroke .18s,stroke-width .18s}\r\n.bz:hover{fill:rgba(232,201,122,.22);stroke:var(--hov);stroke-width:1.4}\r\n.bz.sel-t{fill:rgba(200,169,110,.32);stroke:#c8a96e;stroke-width:1.7}\r\n.pz{fill:rgba(94,196,232,.1);stroke:rgba(94,196,232,.4);stroke-width:1;cursor:pointer;transition:all .18s}\r\n.pz:hover{fill:rgba(232,201,122,.18);stroke:var(--hov);stroke-width:1.4}\r\n.pz.sel-p{fill:rgba(94,196,232,.32);stroke:#5ec4e8;stroke-width:1.7}\r\n.mz{fill:rgba(212,127,191,.1);stroke:rgba(212,127,191,.4);stroke-width:1;cursor:pointer;transition:all .18s}\r\n.mz:hover{fill:rgba(232,201,122,.18);stroke:var(--hov);stroke-width:1.4}\r\n.mz.sel-m{fill:rgba(212,127,191,.32);stroke:#d47fbf;stroke-width:1.7}\r\n.bl{font-size:5.5px;fill:rgba(237,232,224,.7);text-anchor:middle;pointer-events:none;font-family:\u0027DM Sans\u0027,sans-serif}\r\n.bl.sel-t{fill:#c8a96e;font-weight:700}\r\n.bl.sel-p{fill:#5ec4e8;font-weight:700}\r\n.bl.sel-m{fill:#d47fbf;font-weight:700}\r\n.sk{fill:none;stroke:rgba(200,169,110,.12);stroke-width:.5;pointer-events:none}\r\n.ml{fill:none;stroke:rgba(200,169,110,.1);stroke-width:.4;pointer-events:none}\r\n/* placement tags */\r\n.place-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px;min-height:20px}\r\n.ptag{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:12px;font-size:11.5px;font-weight:500;border:1px solid;cursor:pointer;transition:opacity .15s}\r\n.ptag:hover{opacity:.6}\r\n.ptag-t{border-color:rgba(200,169,110,.5);color:var(--g);background:var(--g3)}\r\n.ptag-p{border-color:rgba(94,196,232,.5);color:var(--cp);background:rgba(94,196,232,.08)}\r\n.ptag-m{border-color:rgba(212,127,191,.5);color:var(--cm);background:rgba(212,127,191,.08)}\r\n.place-note{font-size:11px;color:var(--txd);font-style:italic}\r\n.tap-hint{font-size:11px;color:var(--txm);margin-bottom:6px;display:flex;align-items:center;gap:5px}\r\n.tap-hint::before{content:\u0027👆\u0027;font-size:12px}\r\n/* ink allergy fields — kept for skin notes, but number picker removed */\r\n/* upload */\r\n.upzone{border:1.5px dashed rgba(200,169,110,.25);border-radius:10px;padding:1.25rem;text-align:center;cursor:pointer;transition:all .2s}\r\n.upzone:hover{border-color:var(--hov);background:rgba(232,201,122,.04)}\r\n.upzone.has{border-color:var(--grn);border-style:solid;background:rgba(74,140,42,.05)}\r\n.up-ico{font-size:1.4rem;display:block;margin-bottom:5px;opacity:.5}\r\n.up-lbl{font-size:12.5px;color:var(--txm)}\r\n.up-sub{font-size:10.5px;color:var(--txd);margin-top:2px}\r\n.up-name{font-size:12px;color:#7dc46a;margin-top:5px;display:none;font-weight:500}\r\n.up-img{max-width:100%;max-height:120px;border-radius:8px;margin-top:10px;object-fit:contain;display:none}\r\n.pdf-pill{display:none;margin-top:10px;padding:8px 14px;background:rgba(74,140,42,.1);border:1px solid rgba(74,140,42,.3);border-radius:6px;font-size:12px;color:#7dc46a;align-items:center;gap:6px}\r\n.pdf-pill.show{display:flex}\r\n/* slots */\r\n.slot-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:6px}\r\n.slotbtn{padding:9px 4px;min-height:40px;border:1px solid var(--bdr);border-radius:7px;background:var(--s2);color:var(--txm);font-family:\u0027DM Sans\u0027,sans-serif;font-size:12.5px;cursor:pointer;text-align:center;transition:all .18s;font-weight:500}\r\n.slotbtn:hover{border-color:var(--hov);color:var(--hov);background:rgba(232,201,122,.05)}\r\n.slotbtn.on{border-color:var(--g);background:var(--g3);color:var(--g)}\r\n/* consult */\r\n.consult-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}\r\n.cbtn{border:1px solid var(--bdr);border-radius:8px;padding:.75rem .5rem;text-align:center;cursor:pointer;background:var(--s2);transition:all .2s}\r\n.cbtn:hover{border-color:var(--hov);background:rgba(232,201,122,.05)}\r\n.cbtn .ci{font-size:1.2rem;display:block;margin-bottom:4px}\r\n.cbtn .cl{font-size:12px;color:var(--txm)}\r\n.cbtn.on{border-color:var(--g);background:var(--g3)}\r\n.cbtn.on .cl{color:var(--g);font-weight:500}\r\n/* health checkboxes */\r\n.hcheck-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:6px}\r\n.hcheck{display:flex;align-items:flex-start;gap:8px;padding:7px 10px;border:1px solid var(--bdr);border-radius:7px;cursor:pointer;transition:all .18s;background:var(--s2)}\r\n.hcheck:hover{border-color:var(--hov);background:rgba(232,201,122,.04)}\r\n.hcheck input[type=checkbox]{accent-color:var(--g);width:14px;height:14px;margin-top:2px;flex-shrink:0;cursor:pointer}\r\n.hcheck label{font-size:12px;color:var(--txm);cursor:pointer;line-height:1.4}\r\n.hcheck.ticked{border-color:var(--g);background:var(--g3)}\r\n.hcheck.ticked label{color:var(--g)}\r\n/* GDPR block */\r\n.gdpr-block{background:var(--s2);border:1px solid var(--bdr);border-radius:8px;padding:1rem;margin-bottom:1rem;font-size:11px;color:var(--txm);line-height:1.8}\r\n.gdpr-block p{margin-bottom:.5rem}.gdpr-block p:last-child{margin-bottom:0}\r\n.gdpr-block strong{color:rgba(237,232,224,.8)}\r\n/* consent */\r\n.con-row{display:flex;gap:10px;align-items:flex-start;margin-top:10px}\r\n.con-row input[type=checkbox]{accent-color:var(--g);margin-top:3px;flex-shrink:0;width:16px;height:16px;cursor:pointer}\r\n.con-row label{font-size:11.5px;color:var(--txm);line-height:1.7;cursor:pointer}\r\n/* review */\r\n.rv-hd{font-family:\u0027Bebas Neue\u0027,sans-serif;font-size:.8rem;letter-spacing:.1em;color:var(--g);padding:8px 0 4px;border-bottom:1px solid var(--bdr);margin-bottom:5px;margin-top:8px}\r\n.rv-hd:first-child{margin-top:0}\r\n.rv-row{display:flex;justify-content:space-between;align-items:baseline;padding:5px 0;border-bottom:1px solid rgba(200,169,110,.06)}\r\n.rv-row:last-child{border-bottom:none}\r\n.rv-k{font-size:11px;color:var(--txm);flex-shrink:0;margin-right:10px}\r\n.rv-v{font-size:12.5px;font-weight:500;text-align:right;word-break:break-word;max-width:65%}\r\n/* nav */\r\n.nav{display:flex;gap:10px;align-items:center;margin-top:1.25rem;padding:0 1.25rem}\r\n.btn-back{padding:11px 20px;border-radius:8px;font-family:\u0027DM Sans\u0027,sans-serif;font-size:13px;font-weight:500;cursor:pointer;background:transparent;border:1px solid var(--bdr);color:var(--txm);transition:all .2s}\r\n.btn-back:hover{border-color:var(--hov);color:var(--hov);background:rgba(232,201,122,.05)}\r\n.btn-next,.btn-sub{flex:1;padding:12px 20px;border-radius:8px;font-family:\u0027DM Sans\u0027,sans-serif;font-size:14px;font-weight:600;cursor:pointer;background:var(--g);border:none;color:#111;transition:background .2s}\r\n.btn-next:hover,.btn-sub:hover{background:var(--g2)}\r\n/* success */\r\n.succ{text-align:center;padding:3rem 1.25rem}\r\n.succ-mark{width:60px;height:60px;border-radius:50%;background:rgba(74,140,42,.15);border:1.5px solid var(--grn);display:flex;align-items:center;justify-content:center;margin:0 auto 1.25rem;font-size:26px}\r\n.succ-title{font-family:\u0027Bebas Neue\u0027,sans-serif;font-size:2rem;letter-spacing:.1em;color:var(--g);margin-bottom:.5rem}\r\n.succ-msg{font-size:13px;color:var(--txm);line-height:1.8}\r\n.pdf-btn{margin-top:1.25rem;padding:12px 32px;border:1px solid var(--g);border-radius:7px;background:transparent;color:var(--g);font-family:\u0027DM Sans\u0027,sans-serif;font-size:13px;font-weight:600;cursor:pointer;transition:all .2s;display:inline-block}\r\n.pdf-btn:hover{background:var(--g3);border-color:var(--hov);color:var(--hov)}\r\n.pdf-btn:disabled{opacity:.45;cursor:default}\r\n/* ── PHONE PICKER ── */\r\n.phone-row{display:grid;grid-template-columns:120px 1fr;gap:8px}\r\n.phone-row select{background:var(--inp);border:1px solid var(--bdr);border-radius:7px;padding:10px 8px;font-family:\u0027DM Sans\u0027,sans-serif;font-size:13px;color:var(--tx);outline:none;min-height:42px;cursor:pointer;transition:border-color .2s}\r\n.phone-row select:focus{border-color:var(--g)}\r\n.phone-row select:hover{border-color:var(--hov)}\r\n.phone-row select option{background:#1a1713;color:var(--tx)}\r\n\r\n/* ── CUSTOM CALENDAR PICKER ── */\r\n.cal-wrap{position:relative}\r\n.cal-trigger{width:100%;background:var(--inp);border:1px solid var(--bdr);border-radius:7px;padding:10px 12px;font-family:\u0027DM Sans\u0027,sans-serif;font-size:14px;color:var(--tx);outline:none;cursor:pointer;transition:border-color .2s,background .2s;min-height:42px;display:flex;align-items:center;justify-content:space-between;gap:8px;user-select:none}\r\n.cal-trigger:hover{border-color:var(--hov);background:rgba(232,201,122,.03)}\r\n.cal-trigger:focus{border-color:var(--g)}\r\n.cal-trigger.inv{border-color:var(--red)!important}\r\n.cal-trigger.ok{border-color:var(--grn)!important}\r\n.cal-trigger .cal-val{flex:1}\r\n.cal-trigger .cal-ico{font-size:14px;opacity:.5;flex-shrink:0}\r\n.cal-trigger .cal-placeholder{color:var(--txd)}\r\n.cal-popup{\r\n  position:absolute;top:calc(100% + 6px);left:0;z-index:9999;\r\n  background:#1e1b17;border:1px solid var(--bdr2);border-radius:12px;\r\n  box-shadow:0 12px 40px rgba(0,0,0,.7);padding:0;\r\n  width:300px;overflow:hidden;\r\n  animation:calIn .15s ease;\r\n}\r\n@keyframes calIn{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}\r\n.cal-popup.hidden{display:none}\r\n.cal-head{display:flex;align-items:center;justify-content:space-between;padding:12px 14px 8px;border-bottom:1px solid var(--bdr)}\r\n.cal-head-title{font-family:\u0027Bebas Neue\u0027,sans-serif;letter-spacing:.1em;color:var(--g);font-size:.95rem;cursor:pointer}\r\n.cal-head-title:hover{color:var(--hov)}\r\n.cal-nav{background:transparent;border:none;color:var(--txm);font-size:16px;cursor:pointer;padding:4px 8px;border-radius:5px;transition:all .15s;line-height:1}\r\n.cal-nav:hover{background:rgba(232,201,122,.1);color:var(--hov)}\r\n.cal-dow{display:grid;grid-template-columns:repeat(7,1fr);padding:8px 10px 4px}\r\n.cal-dow span{text-align:center;font-size:9.5px;letter-spacing:.06em;color:var(--txd);text-transform:uppercase;padding:4px 0;font-weight:600}\r\n.cal-days{display:grid;grid-template-columns:repeat(7,1fr);padding:4px 10px 10px;gap:2px}\r\n.cal-day{\r\n  aspect-ratio:1;display:flex;align-items:center;justify-content:center;\r\n  border-radius:6px;font-size:12.5px;cursor:pointer;color:var(--txm);\r\n  transition:all .15s;border:1px solid transparent;font-family:\u0027DM Sans\u0027,sans-serif;\r\n}\r\n.cal-day:hover:not(.cal-empty):not(.cal-disabled){background:rgba(232,201,122,.14);color:var(--hov);border-color:rgba(232,201,122,.3)}\r\n.cal-day.cal-today{border-color:rgba(200,169,110,.4);color:var(--g)}\r\n.cal-day.cal-sel{background:var(--g);color:#111;font-weight:700;border-color:var(--g)}\r\n.cal-day.cal-disabled{opacity:.22;cursor:not-allowed;pointer-events:none}\r\n.cal-day.cal-empty{cursor:default}\r\n.cal-day.cal-other-month{opacity:.3}\r\n/* Month/Year select overlay */\r\n.cal-ym-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding:12px;max-height:240px;overflow-y:auto}\r\n.cal-ym-item{padding:8px 4px;text-align:center;border-radius:7px;cursor:pointer;font-size:13px;color:var(--txm);transition:all .15s;border:1px solid transparent}\r\n.cal-ym-item:hover{background:rgba(232,201,122,.12);color:var(--hov);border-color:rgba(232,201,122,.3)}\r\n.cal-ym-item.sel{background:var(--g);color:#111;font-weight:600}\r\n.cal-footer{padding:8px 14px;border-top:1px solid var(--bdr);display:flex;justify-content:space-between;align-items:center}\r\n.cal-today-btn{background:transparent;border:1px solid var(--bdr);border-radius:6px;color:var(--txm);font-family:\u0027DM Sans\u0027,sans-serif;font-size:11px;padding:4px 10px;cursor:pointer;transition:all .15s}\r\n.cal-today-btn:hover{border-color:var(--hov);color:var(--hov)}\r\n.cal-clear-btn{background:transparent;border:none;color:var(--txd);font-size:11px;cursor:pointer;padding:4px;transition:color .15s;font-family:\u0027DM Sans\u0027,sans-serif}\r\n.cal-clear-btn:hover{color:var(--red)}\r\n@media(max-width:340px){.cal-popup{width:calc(100vw - 2.5rem)}}\r\n/* util */\r\n.hidden{display:none!important}\r\n.mt8{margin-top:8px}\r\n@media(max-width:520px){\r\n  .g2,.scat-grid,.zip-row,.phone-row{grid-template-columns:1fr}\r\n  .svc-grid{grid-template-columns:1fr}\r\n  .svc-card{display:flex;align-items:center;gap:12px;text-align:left;padding:.75rem 1rem}\r\n  .svc-card .ico{margin-bottom:0;font-size:1.4rem;flex-shrink:0}\r\n  .slot-grid{grid-template-columns:repeat(3,1fr)}\r\n  .diag-wrap{grid-template-columns:1fr 1fr;gap:8px}\r\n  .svg-diagram{max-width:100%}\r\n  .hcheck-grid{grid-template-columns:1fr}\r\n}\r\n\u003c/style\u003e\r\n\u003c/head\u003e\r\n\u003cbody\u003e\r\n\u003cdiv class=\"tmf\" id=\"tmf\"\u003e\r\n\r\n  \u003cdiv class=\"tmf-hdr\"\u003e\r\n    \u003cdiv\u003e\u003cdiv class=\"brand-name\"\u003eTattooing Erkelenz\u003c/div\u003e\u003cdiv class=\"brand-sub\"\u003eMagic Moon Studio · Since 1990\u003c/div\u003e\u003c/div\u003e\r\n    \u003cdiv class=\"hdr-r\"\u003eBook a\u003cbr\u003eConsultation\u003c/div\u003e\r\n  \u003c/div\u003e\r\n\r\n  \u003cdiv class=\"prog-wrap\"\u003e\r\n    \u003cdiv class=\"prog-bars\"\u003e\r\n      \u003cdiv class=\"pb act\" id=\"pb1\"\u003e\u003c/div\u003e\u003cdiv class=\"pb\" id=\"pb2\"\u003e\u003c/div\u003e\r\n      \u003cdiv class=\"pb\" id=\"pb3\"\u003e\u003c/div\u003e\u003cdiv class=\"pb\" id=\"pb4\"\u003e\u003c/div\u003e\r\n    \u003c/div\u003e\r\n    \u003cdiv class=\"prog-txt\"\u003e\r\n      \u003cspan class=\"prog-step\" id=\"pstep\"\u003eStep 1 of 4\u003c/span\u003e\r\n      \u003cspan class=\"prog-name\" id=\"pname\"\u003eService \u0026amp; personal details\u003c/span\u003e\r\n    \u003c/div\u003e\r\n  \u003c/div\u003e\r\n  \u003cdiv class=\"autosave-bar\" id=\"save-bar\"\u003e\u003cspan class=\"dot\"\u003e\u003c/span\u003e Progress saved\u003c/div\u003e\r\n\r\n  \u003cdiv class=\"sec\"\u003e\r\n    \u003cdiv class=\"mode-tabs\"\u003e\r\n      \u003cbutton type=\"button\" class=\"mode-tab on\" id=\"tab-on\" onclick=\"F.setMode(\u0027online\u0027)\"\u003eOnline Consultation\u003c/button\u003e\r\n      \u003cbutton type=\"button\" class=\"mode-tab\" id=\"tab-wi\" onclick=\"F.setMode(\u0027walkin\u0027)\"\u003eWalk-in Booking\u003c/button\u003e\r\n    \u003c/div\u003e\r\n  \u003c/div\u003e\r\n\r\n  \u003c!-- WALK-IN --\u003e\r\n  \u003cdiv class=\"sec hidden\" id=\"wi-form\"\u003e\r\n    \u003cdiv class=\"card\"\u003e\r\n      \u003cdiv class=\"card-hd\"\u003eWalk-in Appointment \u003cspan class=\"badge badge-r\"\u003eQUICK FORM\u003c/span\u003e\u003c/div\u003e\r\n      \u003cdiv class=\"g2\"\u003e\r\n        \u003cdiv class=\"f\"\u003e\u003clabel\u003eFull name\u003cspan class=\"rstar\"\u003e*\u003c/span\u003e\u003c/label\u003e\u003cinput type=\"text\" id=\"wi-name\" placeholder=\"Your name\" maxlength=\"120\" autocomplete=\"name\"\u003e\u003c/div\u003e\r\n        \u003cdiv class=\"f\"\u003e\u003clabel\u003eEmail\u003cspan class=\"rstar\"\u003e*\u003c/span\u003e\u003c/label\u003e\u003cinput type=\"email\" id=\"wi-email\" placeholder=\"you@email.com\" maxlength=\"200\" autocomplete=\"email\"\u003e\u003c/div\u003e\r\n      \u003c/div\u003e\r\n      \u003cdiv class=\"g2\"\u003e\r\n        \u003cdiv class=\"f\"\u003e\u003clabel\u003eService\u003cspan class=\"rstar\"\u003e*\u003c/span\u003e\u003c/label\u003e\r\n          \u003cselect id=\"wi-svc\"\u003e\u003coption value=\"\"\u003eSelect…\u003c/option\u003e\u003coption\u003eTattoo\u003c/option\u003e\u003coption\u003ePiercing\u003c/option\u003e\u003coption\u003ePMU\u003c/option\u003e\u003c/select\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"f\"\u003e\u003clabel\u003eDate\u003cspan class=\"rstar\"\u003e*\u003c/span\u003e\u003c/label\u003e\u003cinput type=\"date\" id=\"wi-date\" autocomplete=\"off\"\u003e\u003c/div\u003e\r\n      \u003c/div\u003e\r\n      \u003cdiv class=\"f\"\u003e\u003clabel\u003eTime slot\u003cspan class=\"rstar\"\u003e*\u003c/span\u003e\u003c/label\u003e\r\n        \u003cdiv class=\"slot-grid\"\u003e\r\n          \u003cbutton type=\"button\" class=\"slotbtn\" data-slot=\"10:00\" onclick=\"F.pickSlot(this,\u0027wi\u0027)\"\u003e10:00\u003c/button\u003e\r\n          \u003cbutton type=\"button\" class=\"slotbtn\" data-slot=\"12:00\" onclick=\"F.pickSlot(this,\u0027wi\u0027)\"\u003e12:00\u003c/button\u003e\r\n          \u003cbutton type=\"button\" class=\"slotbtn\" data-slot=\"14:00\" onclick=\"F.pickSlot(this,\u0027wi\u0027)\"\u003e14:00\u003c/button\u003e\r\n          \u003cbutton type=\"button\" class=\"slotbtn\" data-slot=\"16:00\" onclick=\"F.pickSlot(this,\u0027wi\u0027)\"\u003e16:00\u003c/button\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n      \u003cdiv id=\"wi-err\" class=\"errmsg\"\u003e\u003c/div\u003e\r\n    \u003c/div\u003e\r\n    \u003cdiv class=\"nav\"\u003e\u003cbutton type=\"button\" class=\"btn-next\" onclick=\"F.submitWI()\"\u003eConfirm Walk-in →\u003c/button\u003e\u003c/div\u003e\r\n  \u003c/div\u003e\r\n\r\n  \u003c!-- ONLINE STEPS --\u003e\r\n  \u003cdiv id=\"online-form\"\u003e\r\n\r\n    \u003c!-- STEP 1 --\u003e\r\n    \u003cdiv class=\"sec step active\" id=\"step1\"\u003e\r\n      \u003cdiv class=\"card\"\u003e\r\n        \u003cdiv class=\"card-hd\"\u003eChoose your service\u003cspan class=\"rstar\"\u003e*\u003c/span\u003e\u003c/div\u003e\r\n        \u003cdiv class=\"svc-grid\"\u003e\r\n          \u003cbutton type=\"button\" class=\"svc-card\" id=\"sc-tattoo\" onclick=\"F.pickSvc(\u0027tattoo\u0027)\"\u003e\r\n            \u003cdiv class=\"ck\"\u003e✓\u003c/div\u003e\u003cspan class=\"ico\"\u003e🖋\u003c/span\u003e\u003cspan class=\"sn\"\u003eTattoo\u003c/span\u003e\u003cspan class=\"ss\"\u003eAll styles · Custom art\u003c/span\u003e\r\n          \u003c/button\u003e\r\n          \u003cbutton type=\"button\" class=\"svc-card\" id=\"sc-piercing\" onclick=\"F.pickSvc(\u0027piercing\u0027)\"\u003e\r\n            \u003cdiv class=\"ck\"\u003e✓\u003c/div\u003e\u003cspan class=\"ico\"\u003e💎\u003c/span\u003e\u003cspan class=\"sn\"\u003ePiercing\u003c/span\u003e\u003cspan class=\"ss\"\u003eEar · Face · Body · Intimate\u003c/span\u003e\r\n          \u003c/button\u003e\r\n          \u003cbutton type=\"button\" class=\"svc-card\" id=\"sc-pmu\" onclick=\"F.pickSvc(\u0027pmu\u0027)\"\u003e\r\n            \u003cdiv class=\"ck\"\u003e✓\u003c/div\u003e\u003cspan class=\"ico\"\u003e✦\u003c/span\u003e\u003cspan class=\"sn\"\u003ePMU\u003c/span\u003e\u003cspan class=\"ss\"\u003eBrows · Lips · Eyes · SMP\u003c/span\u003e\r\n          \u003c/button\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"errmsg\" id=\"e-svc\"\u003ePlease select a service\u003c/div\u003e\r\n      \u003c/div\u003e\r\n\r\n      \u003cdiv class=\"card\"\u003e\r\n        \u003cdiv class=\"card-hd\"\u003eYour details \u003cspan class=\"badge badge-r\"\u003eALL REQUIRED\u003c/span\u003e\u003c/div\u003e\r\n        \u003cdiv class=\"g2\"\u003e\r\n          \u003cdiv class=\"f\"\u003e\r\n            \u003clabel\u003eFull name\u003cspan class=\"rstar\"\u003e*\u003c/span\u003e\u003c/label\u003e\r\n            \u003cinput type=\"text\" id=\"p-name\" placeholder=\"Your full name\" maxlength=\"120\" autocomplete=\"name\"\u003e\r\n            \u003cdiv class=\"errmsg\" id=\"e-name\"\u003eRequired\u003c/div\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv class=\"f\"\u003e\r\n            \u003clabel\u003eDate of birth\u003cspan class=\"rstar\"\u003e*\u003c/span\u003e\u003c/label\u003e\r\n            \u003cdiv class=\"cal-wrap\" id=\"dob-wrap\"\u003e\r\n              \u003cbutton type=\"button\" class=\"cal-trigger\" id=\"dob-trigger\" onclick=\"_H.openCal(\u0027dob\u0027)\"\u003e\r\n                \u003cspan class=\"cal-val cal-placeholder\" id=\"dob-display\"\u003eSelect date of birth\u003c/span\u003e\r\n                \u003cspan class=\"cal-ico\"\u003e📅\u003c/span\u003e\r\n              \u003c/button\u003e\r\n              \u003cdiv class=\"cal-popup hidden\" id=\"cal-popup-dob\"\u003e\u003c/div\u003e\r\n            \u003c/div\u003e\r\n            \u003cinput type=\"hidden\" id=\"p-dob\" autocomplete=\"bday\"\u003e\r\n            \u003cdiv class=\"errmsg\" id=\"e-dob\"\u003eRequired\u003c/div\u003e\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"g2\"\u003e\r\n          \u003cdiv class=\"f\"\u003e\r\n            \u003clabel\u003eEmail\u003cspan class=\"rstar\"\u003e*\u003c/span\u003e\u003c/label\u003e\r\n            \u003cinput type=\"email\" id=\"p-email\" placeholder=\"you@email.com\" maxlength=\"200\" autocomplete=\"email\"\u003e\r\n            \u003cdiv class=\"errmsg\" id=\"e-email\"\u003eValid email required\u003c/div\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv class=\"f\"\u003e\r\n            \u003clabel\u003ePhone number\u003cspan class=\"rstar\"\u003e*\u003c/span\u003e\u003c/label\u003e\r\n            \u003cdiv class=\"phone-row\"\u003e\r\n              \u003cselect id=\"p-dialcode\" autocomplete=\"tel-country-code\" onchange=\"F.livePhone()\"\u003e\r\n                \u003coption value=\"+49\" data-c=\"DE\"\u003e🇩🇪 +49\u003c/option\u003e\r\n                \u003coption value=\"+43\" data-c=\"AT\"\u003e🇦🇹 +43\u003c/option\u003e\r\n                \u003coption value=\"+41\" data-c=\"CH\"\u003e🇨🇭 +41\u003c/option\u003e\r\n                \u003coption value=\"+31\" data-c=\"NL\"\u003e🇳🇱 +31\u003c/option\u003e\r\n                \u003coption value=\"+32\" data-c=\"BE\"\u003e🇧🇪 +32\u003c/option\u003e\r\n                \u003coption value=\"+33\" data-c=\"FR\"\u003e🇫🇷 +33\u003c/option\u003e\r\n                \u003coption value=\"+44\" data-c=\"GB\"\u003e🇬🇧 +44\u003c/option\u003e\r\n                \u003coption value=\"+1\"  data-c=\"US\"\u003e🇺🇸 +1\u003c/option\u003e\r\n                \u003coption value=\"+1\"  data-c=\"CA\"\u003e🇨🇦 +1 CA\u003c/option\u003e\r\n                \u003coption value=\"+61\" data-c=\"AU\"\u003e🇦🇺 +61\u003c/option\u003e\r\n                \u003coption value=\"+90\" data-c=\"TR\"\u003e🇹🇷 +90\u003c/option\u003e\r\n                \u003coption value=\"+48\" data-c=\"PL\"\u003e🇵🇱 +48\u003c/option\u003e\r\n                \u003coption value=\"+39\" data-c=\"IT\"\u003e🇮🇹 +39\u003c/option\u003e\r\n                \u003coption value=\"+34\" data-c=\"ES\"\u003e🇪🇸 +34\u003c/option\u003e\r\n                \u003coption value=\"+351\" data-c=\"PT\"\u003e🇵🇹 +351\u003c/option\u003e\r\n                \u003coption value=\"+30\"  data-c=\"GR\"\u003e🇬🇷 +30\u003c/option\u003e\r\n                \u003coption value=\"+420\" data-c=\"CZ\"\u003e🇨🇿 +420\u003c/option\u003e\r\n                \u003coption value=\"+36\"  data-c=\"HU\"\u003e🇭🇺 +36\u003c/option\u003e\r\n                \u003coption value=\"+40\"  data-c=\"RO\"\u003e🇷🇴 +40\u003c/option\u003e\r\n                \u003coption value=\"+7\"   data-c=\"RU\"\u003e🇷🇺 +7\u003c/option\u003e\r\n                \u003coption value=\"+86\"  data-c=\"CN\"\u003e🇨🇳 +86\u003c/option\u003e\r\n                \u003coption value=\"+91\"  data-c=\"IN\"\u003e🇮🇳 +91\u003c/option\u003e\r\n                \u003coption value=\"+81\"  data-c=\"JP\"\u003e🇯🇵 +81\u003c/option\u003e\r\n                \u003coption value=\"+82\"  data-c=\"KR\"\u003e🇰🇷 +82\u003c/option\u003e\r\n                \u003coption value=\"+55\"  data-c=\"BR\"\u003e🇧🇷 +55\u003c/option\u003e\r\n                \u003coption value=\"+52\"  data-c=\"MX\"\u003e🇲🇽 +52\u003c/option\u003e\r\n                \u003coption value=\"+971\" data-c=\"AE\"\u003e🇦🇪 +971\u003c/option\u003e\r\n                \u003coption value=\"+966\" data-c=\"SA\"\u003e🇸🇦 +966\u003c/option\u003e\r\n                \u003coption value=\"+27\"  data-c=\"ZA\"\u003e🇿🇦 +27\u003c/option\u003e\r\n                \u003coption value=\"+20\"  data-c=\"EG\"\u003e🇪🇬 +20\u003c/option\u003e\r\n              \u003c/select\u003e\r\n              \u003cinput type=\"tel\" id=\"p-phone\" placeholder=\"151 12345678\" maxlength=\"15\"\r\n                     autocomplete=\"tel-national\" oninput=\"F.livePhone()\"\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class=\"errmsg\" id=\"e-phone\"\u003ePlease enter a valid local phone number (digits only, no spaces)\u003c/div\u003e\r\n            \u003cdiv class=\"okmsg\" id=\"ok-phone\"\u003e✓ Valid number\u003c/div\u003e\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"g2\"\u003e\r\n          \u003cdiv class=\"f\"\u003e\r\n            \u003clabel\u003eStreet address\u003cspan class=\"rstar\"\u003e*\u003c/span\u003e\u003c/label\u003e\r\n            \u003cinput type=\"text\" id=\"p-street\" placeholder=\"Street and number\" maxlength=\"160\" autocomplete=\"street-address\"\u003e\r\n            \u003cdiv class=\"errmsg\" id=\"e-street\"\u003eRequired\u003c/div\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv class=\"f\"\u003e\r\n            \u003clabel\u003eCity\u003cspan class=\"rstar\"\u003e*\u003c/span\u003e\u003c/label\u003e\r\n            \u003cinput type=\"text\" id=\"p-city\" placeholder=\"City\" maxlength=\"80\" autocomplete=\"address-level2\"\u003e\r\n            \u003cdiv class=\"errmsg\" id=\"e-city\"\u003eRequired\u003c/div\u003e\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \u003c!-- Separated country + postal code --\u003e\r\n        \u003cdiv class=\"zip-row\"\u003e\r\n          \u003cdiv class=\"f\"\u003e\r\n            \u003clabel\u003eCountry\u003cspan class=\"rstar\"\u003e*\u003c/span\u003e\u003c/label\u003e\r\n            \u003cselect id=\"p-country\" autocomplete=\"country\" onchange=\"F.onCountryChange()\"\u003e\r\n              \u003coption value=\"\"\u003e— Select —\u003c/option\u003e\r\n              \u003coption value=\"DE\"\u003e🇩🇪 Germany\u003c/option\u003e\r\n              \u003coption value=\"AT\"\u003e🇦🇹 Austria\u003c/option\u003e\r\n              \u003coption value=\"CH\"\u003e🇨🇭 Switzerland\u003c/option\u003e\r\n              \u003coption value=\"NL\"\u003e🇳🇱 Netherlands\u003c/option\u003e\r\n              \u003coption value=\"BE\"\u003e🇧🇪 Belgium\u003c/option\u003e\r\n              \u003coption value=\"FR\"\u003e🇫🇷 France\u003c/option\u003e\r\n              \u003coption value=\"GB\"\u003e🇬🇧 United Kingdom\u003c/option\u003e\r\n              \u003coption value=\"US\"\u003e🇺🇸 United States\u003c/option\u003e\r\n              \u003coption value=\"CA\"\u003e🇨🇦 Canada\u003c/option\u003e\r\n              \u003coption value=\"AU\"\u003e🇦🇺 Australia\u003c/option\u003e\r\n              \u003coption value=\"TR\"\u003e🇹🇷 Turkey\u003c/option\u003e\r\n              \u003coption value=\"PL\"\u003e🇵🇱 Poland\u003c/option\u003e\r\n              \u003coption value=\"IT\"\u003e🇮🇹 Italy\u003c/option\u003e\r\n              \u003coption value=\"ES\"\u003e🇪🇸 Spain\u003c/option\u003e\r\n              \u003coption value=\"OTHER\"\u003e🌍 Other\u003c/option\u003e\r\n            \u003c/select\u003e\r\n            \u003cdiv class=\"errmsg\" id=\"e-country\"\u003eRequired\u003c/div\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv class=\"f\"\u003e\r\n            \u003clabel\u003ePostal / ZIP code\u003cspan class=\"rstar\"\u003e*\u003c/span\u003e\u003c/label\u003e\r\n            \u003cinput type=\"text\" id=\"p-zip\" placeholder=\"e.g. 41812\" maxlength=\"12\" autocomplete=\"postal-code\" oninput=\"F.liveZip(this)\"\u003e\r\n            \u003cdiv class=\"errmsg\" id=\"e-zip\"\u003eInvalid postal code for selected country\u003c/div\u003e\r\n            \u003cdiv class=\"okmsg\" id=\"ok-zip\"\u003e✓ Valid postal code\u003c/div\u003e\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \u003c!-- Artist — hidden for piercing/pmu --\u003e\r\n        \u003cdiv class=\"f\" id=\"artist-field\"\u003e\r\n          \u003clabel\u003ePreferred artist\u003cspan class=\"rstar\"\u003e*\u003c/span\u003e\u003c/label\u003e\r\n          \u003cselect id=\"p-artist\" autocomplete=\"off\"\u003e\r\n            \u003coption value=\"\"\u003e— Select artist —\u003c/option\u003e\r\n            \u003coption\u003eMax\u003c/option\u003e\u003coption\u003eLisa\u003c/option\u003e\u003coption\u003eTom\u003c/option\u003e\u003coption\u003eSarah\u003c/option\u003e\u003coption\u003eNo preference\u003c/option\u003e\r\n          \u003c/select\u003e\r\n          \u003cdiv class=\"errmsg\" id=\"e-artist\"\u003ePlease select\u003c/div\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n      \u003cdiv class=\"nav\"\u003e\u003cbutton type=\"button\" class=\"btn-next\" onclick=\"F.go(2)\"\u003eContinue →\u003c/button\u003e\u003c/div\u003e\r\n    \u003c/div\u003e\r\n\r\n    \u003c!-- STEP 2: SERVICE DETAILS (DOM-safe static panels, no user data in innerHTML) --\u003e\r\n    \u003cdiv class=\"sec step hidden\" id=\"step2\"\u003e\r\n      \u003c!-- All three panels pre-rendered in static HTML — no innerHTML injection --\u003e\r\n      \u003cdiv id=\"panel-tattoo\" class=\"hidden\"\u003e\u003c!-- injected once, statically --\u003e\u003c/div\u003e\r\n      \u003cdiv id=\"panel-piercing\" class=\"hidden\"\u003e\u003c/div\u003e\r\n      \u003cdiv id=\"panel-pmu\" class=\"hidden\"\u003e\u003c/div\u003e\r\n      \u003cdiv class=\"nav\"\u003e\r\n        \u003cbutton type=\"button\" class=\"btn-back\" onclick=\"F.go(1)\"\u003e← Back\u003c/button\u003e\r\n        \u003cbutton type=\"button\" class=\"btn-next\" onclick=\"F.go(3)\"\u003eContinue →\u003c/button\u003e\r\n      \u003c/div\u003e\r\n    \u003c/div\u003e\r\n\r\n    \u003c!-- STEP 3: PLACEMENT + HEALTH + UPLOAD --\u003e\r\n    \u003cdiv class=\"sec step hidden\" id=\"step3\"\u003e\r\n      \u003cdiv id=\"place-tattoo\" class=\"hidden\"\u003e\u003c/div\u003e\r\n      \u003cdiv id=\"place-piercing\" class=\"hidden\"\u003e\u003c/div\u003e\r\n      \u003cdiv id=\"place-pmu\" class=\"hidden\"\u003e\u003c/div\u003e\r\n\r\n      \u003c!-- Health — service-specific checkboxes (built via DOM API, no innerHTML with user data) --\u003e\r\n      \u003cdiv class=\"card\"\u003e\r\n        \u003cdiv class=\"card-hd\"\u003eHealth Declaration \u003cspan class=\"badge badge-r\"\u003eREQUIRED\u003c/span\u003e\u003c/div\u003e\r\n        \u003cp class=\"hint\"\u003eTick all conditions that apply to you. At least one response is required. This information is kept strictly confidential per Art. 9 EU-GDPR.\u003c/p\u003e\r\n        \u003cdiv id=\"health-checks\" class=\"hcheck-grid\"\u003e\u003c/div\u003e\r\n        \u003cdiv class=\"f mt8\"\u003e\r\n          \u003clabel\u003eAdditional health notes \u003cspan style=\"font-size:10px;color:var(--txd)\"\u003e(optional)\u003c/span\u003e\u003c/label\u003e\r\n          \u003ctextarea id=\"p-health-extra\" style=\"min-height:55px\" placeholder=\"Any further detail not covered above…\" maxlength=\"800\" autocomplete=\"off\"\u003e\u003c/textarea\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"errmsg\" id=\"e-health\"\u003ePlease complete the health declaration — tick at least one option\u003c/div\u003e\r\n      \u003c/div\u003e\r\n\r\n      \u003c!-- Upload --\u003e\r\n      \u003cdiv class=\"card\"\u003e\r\n        \u003cdiv class=\"card-hd\"\u003eReference Image \u003cspan class=\"badge badge-o\"\u003eOPTIONAL\u003c/span\u003e\u003c/div\u003e\r\n        \u003cp class=\"hint\"\u003eUpload your design, reference, or inspiration. Images show as preview; PDFs show filename only.\u003c/p\u003e\r\n        \u003cdiv class=\"upzone\" id=\"upzone\" onclick=\"document.getElementById(\u0027finput\u0027).click()\"\u003e\r\n          \u003cspan class=\"up-ico\"\u003e↑\u003c/span\u003e\r\n          \u003cdiv class=\"up-lbl\"\u003eClick to upload design or reference\u003c/div\u003e\r\n          \u003cdiv class=\"up-sub\"\u003eJPG · PNG · WebP · PDF · max 10 MB\u003c/div\u003e\r\n          \u003cdiv class=\"up-name\" id=\"up-name\"\u003e\u003c/div\u003e\r\n          \u003cimg id=\"up-img\" class=\"up-img\" alt=\"Reference preview\"\u003e\r\n          \u003cdiv class=\"pdf-pill\" id=\"pdf-pill\"\u003e📄 \u003cspan id=\"pdf-fname\"\u003e\u003c/span\u003e\u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \u003cinput type=\"file\" id=\"finput\" accept=\"image/jpeg,image/png,image/webp,application/pdf\" onchange=\"F.handleFile(this)\" style=\"display:none\" autocomplete=\"off\"\u003e\r\n      \u003c/div\u003e\r\n\r\n      \u003c!-- Additional notes — OPTIONAL --\u003e\r\n      \u003cdiv class=\"card\"\u003e\r\n        \u003cdiv class=\"card-hd\"\u003eAdditional Notes \u003cspan class=\"badge badge-o\"\u003eOPTIONAL\u003c/span\u003e\u003c/div\u003e\r\n        \u003ctextarea id=\"p-notes\" style=\"min-height:60px\" placeholder=\"Special requests, questions, anything else for your artist or piercer…\" maxlength=\"800\" autocomplete=\"off\"\u003e\u003c/textarea\u003e\r\n      \u003c/div\u003e\r\n\r\n      \u003cdiv class=\"nav\"\u003e\r\n        \u003cbutton type=\"button\" class=\"btn-back\" onclick=\"F.go(2)\"\u003e← Back\u003c/button\u003e\r\n        \u003cbutton type=\"button\" class=\"btn-next\" onclick=\"F.go(4)\"\u003eContinue →\u003c/button\u003e\r\n      \u003c/div\u003e\r\n    \u003c/div\u003e\r\n\r\n    \u003c!-- STEP 4: BOOK + REVIEW + CONSENT --\u003e\r\n    \u003cdiv class=\"sec step hidden\" id=\"step4\"\u003e\r\n      \u003cdiv class=\"card\"\u003e\r\n        \u003cdiv class=\"card-hd\"\u003eBook Your Consultation \u003cspan class=\"badge badge-r\"\u003eREQUIRED\u003c/span\u003e\u003c/div\u003e\r\n        \u003cdiv class=\"g2\"\u003e\r\n          \u003cdiv class=\"f\"\u003e\r\n            \u003clabel\u003ePreferred date\u003cspan class=\"rstar\"\u003e*\u003c/span\u003e\u003c/label\u003e\r\n            \u003cdiv class=\"cal-wrap\" id=\"appt-wrap\"\u003e\r\n              \u003cbutton type=\"button\" class=\"cal-trigger\" id=\"appt-trigger\" onclick=\"_H.openCal(\u0027appt\u0027)\"\u003e\r\n                \u003cspan class=\"cal-val cal-placeholder\" id=\"appt-display\"\u003eSelect preferred date\u003c/span\u003e\r\n                \u003cspan class=\"cal-ico\"\u003e📅\u003c/span\u003e\r\n              \u003c/button\u003e\r\n              \u003cdiv class=\"cal-popup hidden\" id=\"cal-popup-appt\"\u003e\u003c/div\u003e\r\n            \u003c/div\u003e\r\n            \u003cinput type=\"hidden\" id=\"p-date\" autocomplete=\"off\"\u003e\r\n            \u003cdiv class=\"errmsg\" id=\"e-date\"\u003ePlease select a date\u003c/div\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv class=\"f\"\u003e\r\n            \u003clabel\u003eConsultation type\u003cspan class=\"rstar\"\u003e*\u003c/span\u003e\u003c/label\u003e\r\n            \u003cdiv class=\"consult-row\"\u003e\r\n              \u003cbutton type=\"button\" class=\"cbtn\" data-val=\"In-studio\" onclick=\"F.pickConsult(this)\"\u003e\u003cspan class=\"ci\"\u003e🏠\u003c/span\u003e\u003cspan class=\"cl\"\u003eIn-studio\u003c/span\u003e\u003c/button\u003e\r\n              \u003cbutton type=\"button\" class=\"cbtn\" data-val=\"Video call\" onclick=\"F.pickConsult(this)\"\u003e\u003cspan class=\"ci\"\u003e📹\u003c/span\u003e\u003cspan class=\"cl\"\u003eVideo call\u003c/span\u003e\u003c/button\u003e\r\n              \u003cbutton type=\"button\" class=\"cbtn\" data-val=\"Phone call\" onclick=\"F.pickConsult(this)\"\u003e\u003cspan class=\"ci\"\u003e📞\u003c/span\u003e\u003cspan class=\"cl\"\u003ePhone call\u003c/span\u003e\u003c/button\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class=\"errmsg\" id=\"e-consult\"\u003ePlease select type\u003c/div\u003e\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"f\"\u003e\r\n          \u003clabel\u003eTime slot\u003cspan class=\"rstar\"\u003e*\u003c/span\u003e\u003c/label\u003e\r\n          \u003cdiv class=\"slot-grid\"\u003e\r\n            \u003cbutton type=\"button\" class=\"slotbtn\" data-slot=\"10:00\" onclick=\"F.pickSlot(this,\u0027on\u0027)\"\u003e10:00\u003c/button\u003e\r\n            \u003cbutton type=\"button\" class=\"slotbtn\" data-slot=\"11:00\" onclick=\"F.pickSlot(this,\u0027on\u0027)\"\u003e11:00\u003c/button\u003e\r\n            \u003cbutton type=\"button\" class=\"slotbtn\" data-slot=\"12:00\" onclick=\"F.pickSlot(this,\u0027on\u0027)\"\u003e12:00\u003c/button\u003e\r\n            \u003cbutton type=\"button\" class=\"slotbtn\" data-slot=\"13:00\" onclick=\"F.pickSlot(this,\u0027on\u0027)\"\u003e13:00\u003c/button\u003e\r\n            \u003cbutton type=\"button\" class=\"slotbtn\" data-slot=\"14:00\" onclick=\"F.pickSlot(this,\u0027on\u0027)\"\u003e14:00\u003c/button\u003e\r\n            \u003cbutton type=\"button\" class=\"slotbtn\" data-slot=\"16:00\" onclick=\"F.pickSlot(this,\u0027on\u0027)\"\u003e16:00\u003c/button\u003e\r\n            \u003cbutton type=\"button\" class=\"slotbtn\" data-slot=\"17:00\" onclick=\"F.pickSlot(this,\u0027on\u0027)\"\u003e17:00\u003c/button\u003e\r\n            \u003cbutton type=\"button\" class=\"slotbtn\" data-slot=\"18:00\" onclick=\"F.pickSlot(this,\u0027on\u0027)\"\u003e18:00\u003c/button\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv class=\"errmsg\" id=\"e-slot\"\u003ePlease select a time slot\u003c/div\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n\r\n      \u003c!-- Review (DOM API only — zero innerHTML with user data) --\u003e\r\n      \u003cdiv class=\"card\"\u003e\u003cdiv class=\"card-hd\"\u003eReview Your Submission\u003c/div\u003e\u003cdiv id=\"review-body\"\u003e\u003c/div\u003e\u003c/div\u003e\r\n\r\n      \u003c!-- GDPR — verbatim from Terminblatt PDF --\u003e\r\n      \u003cdiv class=\"card\"\u003e\r\n        \u003cdiv class=\"card-hd\"\u003eData Protection \u0026amp; Consent\u003c/div\u003e\r\n        \u003cdiv class=\"gdpr-block\"\u003e\r\n          \u003cp\u003e\u003cstrong\u003eData Protection Declaration\u003c/strong\u003e\u003c/p\u003e\r\n          \u003cp\u003eIn this appointment/consent form, personal and health related information will be collected in order for us to decide whether the execution of our contracted services poses any risk to your health or may affect end results of our service. Therefore, the contract cannot be performed without this data collection.\u003c/p\u003e\r\n          \u003cp\u003eThe information collected will be processed as a \u003cstrong\u003especial category of personal data\u003c/strong\u003e, as determined by \u003cstrong\u003eArt. 9 of the EU-GDPR\u003c/strong\u003e. By submitting this form you automatically consent to its collection. Personal data will not be forwarded to third parties and will be stored for \u003cstrong\u003e10 years\u003c/strong\u003e. Hereafter, this consent form will be destroyed.\u003c/p\u003e\r\n          \u003cp\u003ePhotographic material of the finished piece will likely be produced. The client may consent to the publishing of these photographs (complying to \u003cstrong\u003eArt. 6 §1 of the EU-GDPR\u003c/strong\u003e) for marketing purposes on our website, social media channels and print media. This consent can be withdrawn at any time (\u003cstrong\u003eArt. 7 §3 of the EU-GDPR\u003c/strong\u003e), in which case we will cease to use the photo material produced under this agreement.\u003c/p\u003e\r\n          \u003cp\u003eThe health related data collected will be kept until the end of the storage period stipulated by law (10 years), as the collection of this information was legitimate up until consent withdrawal.\u003c/p\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"con-row\"\u003e\r\n          \u003cinput type=\"checkbox\" id=\"c1\"\u003e\r\n          \u003clabel for=\"c1\"\u003eI consent to the collection and processing of my personal and health-related data as a \u003cstrong\u003especial category of personal data\u003c/strong\u003e per \u003cstrong\u003eArt. 9 EU-GDPR\u003c/strong\u003e, stored for 10 years, not shared with third parties. I understand this data collection is required to perform the contracted service. \u003cstrong style=\"color:var(--red)\"\u003eRequired *\u003c/strong\u003e\u003c/label\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"con-row\"\u003e\r\n          \u003cinput type=\"checkbox\" id=\"c2\"\u003e\r\n          \u003clabel for=\"c2\"\u003eI consent to photographs/videos of the finished result being published for marketing purposes (website, social media, print) per \u003cstrong\u003eArt. 6 §1 EU-GDPR\u003c/strong\u003e. I can withdraw this consent at any time per \u003cstrong\u003eArt. 7 §3 EU-GDPR\u003c/strong\u003e. \u003cem\u003eOptional.\u003c/em\u003e\u003c/label\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"con-row\"\u003e\r\n          \u003cinput type=\"checkbox\" id=\"c3\"\u003e\r\n          \u003clabel for=\"c3\"\u003eI confirm all information provided in this form is accurate and complete. I understand that providing false health information may affect the safety and outcome of my treatment. \u003cstrong style=\"color:var(--red)\"\u003eRequired *\u003c/strong\u003e\u003c/label\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"errmsg\" id=\"e-consent\" style=\"margin-top:8px\"\u003ePlease accept both required consents above\u003c/div\u003e\r\n      \u003c/div\u003e\r\n\r\n      \u003cdiv class=\"nav\"\u003e\r\n        \u003cbutton type=\"button\" class=\"btn-back\" onclick=\"F.go(3)\"\u003e← Back\u003c/button\u003e\r\n        \u003cbutton type=\"button\" class=\"btn-sub\" onclick=\"F.submit()\"\u003eConfirm \u0026amp; Submit →\u003c/button\u003e\r\n      \u003c/div\u003e\r\n    \u003c/div\u003e\r\n\r\n  \u003c/div\u003e\u003c!-- /online-form --\u003e\r\n\r\n  \u003c!-- SUCCESS --\u003e\r\n  \u003cdiv class=\"sec hidden\" id=\"succ-screen\"\u003e\r\n    \u003cdiv class=\"succ\"\u003e\r\n      \u003cdiv class=\"succ-mark\"\u003e✓\u003c/div\u003e\r\n      \u003cdiv class=\"succ-title\"\u003eBooking Confirmed!\u003c/div\u003e\r\n      \u003cdiv class=\"succ-msg\"\u003eYour consultation request has been received.\u003cbr\u003eWe will contact you shortly to confirm your appointment.\u003cbr\u003e\u003cbr\u003eDownload your personal consultation summary below.\u003c/div\u003e\r\n      \u003cbutton type=\"button\" class=\"pdf-btn\" id=\"pdf-btn\" onclick=\"F.generatePDF()\"\u003eDownload My Consultation Summary →\u003c/button\u003e\r\n    \u003c/div\u003e\r\n  \u003c/div\u003e\r\n\r\n\u003c/div\u003e\u003c!-- /tmf --\u003e\r\n\u003cscript\u003e\r\n/* ════════════════════════════════════════════════════════════\r\n   TATTOOING ERKELENZ — Consultation Form v5\r\n   SECURITY: No innerHTML with user data. All user content\r\n   rendered via textContent / DOM API only. Static HTML\r\n   panels use insertAdjacentHTML once (developer content only).\r\n   Phone: ITU-T E.164  |  ZIP: per-country regex lookup.\r\n   Autosave: versioned localStorage key (v5). Globals: frozen.\r\n════════════════════════════════════════════════════════════ */\r\n(function(){\r\n\u0027use strict\u0027;\r\n\r\n/* ── CONSTANTS ── */\r\nvar LS_KEY = \u0027tme_form_v5\u0027; /* versioned — old poisoned keys ignored */\r\n\r\n/* ── STATE ── */\r\nvar step = 1, svc = \u0027\u0027, mode = \u0027online\u0027;\r\nvar D = {\r\n  style:\u0027\u0027, color:\u0027\u0027, size:\u0027\u0027, orient:\u0027\u0027, consult:\u0027\u0027,\r\n  ptypes:[], pmutypes:[], jewelry:\u0027\u0027, skin_type:\u0027\u0027, prev_pmu:\u0027\u0027, pside:\u0027\u0027,\r\n  placements_t:[], placements_p:[], placements_m:[],\r\n  onSlot:\u0027\u0027, wiSlot:\u0027\u0027, uploadName:\u0027\u0027, uploadBase64:\u0027\u0027, uploadMime:\u0027\u0027\r\n};\r\nvar panelsInjected = {svc:false, place:false};\r\n\r\n/* ── HELPERS (no innerHTML with user data) ── */\r\nfunction $(id){ return document.getElementById(id); }\r\n\r\n/* Safe get value */\r\nfunction gv(id){ var e=$(id); return e ? e.value.trim() : \u0027\u0027; }\r\n\r\n/* Safe set text — never innerHTML */\r\nfunction st(el, txt){ if(el) el.textContent = String(txt||\u0027\u0027); }\r\n\r\n/* Safe error/ok toggles */\r\nfunction se(id, show){ var e=$(id); if(!e) return; if(show) e.classList.add(\u0027show\u0027); else e.classList.remove(\u0027show\u0027); }\r\nfunction so(id, show){ var e=$(id); if(!e) return; if(show) e.classList.add(\u0027show\u0027); else e.classList.remove(\u0027show\u0027); }\r\nfunction inv(id, bad){ var e=$(id); if(e){ e.classList.toggle(\u0027inv\u0027, bad); e.classList.toggle(\u0027ok\u0027, !bad \u0026\u0026 e.value.trim().length\u003e0); } }\r\n\r\nfunction scrollUp(){ document.getElementById(\u0027tmf\u0027).scrollIntoView({behavior:\u0027smooth\u0027, block:\u0027start\u0027}); }\r\n\r\n/* ── POSTAL CODE PATTERNS (per-country, research-backed) ──\r\n   Sources: GeoPostcodes, UPU, ISO 3166\r\n   Strategy: country dropdown drives which regex applies.\r\n   Universal fallback: 3–10 alphanumeric chars (covers most countries).\r\n   ITU-T E.164: ^\\+[1-9]\\d{1,14}$ — max 15 digits, must start with +\r\n*/\r\nvar ZIP_PATTERNS = {\r\n  \u0027DE\u0027: /^\\d{5}$/,                                        /* Germany: 5 digits */\r\n  \u0027AT\u0027: /^\\d{4}$/,                                        /* Austria: 4 digits */\r\n  \u0027CH\u0027: /^\\d{4}$/,                                        /* Switzerland: 4 digits */\r\n  \u0027NL\u0027: /^\\d{4}\\s?[A-Z]{2}$/i,                           /* Netherlands: 1234 AB */\r\n  \u0027BE\u0027: /^\\d{4}$/,                                        /* Belgium: 4 digits */\r\n  \u0027FR\u0027: /^\\d{5}$/,                                        /* France: 5 digits */\r\n  \u0027GB\u0027: /^[A-Z]{1,2}\\d[A-Z\\d]?\\s?\\d[A-Z]{2}$/i,         /* UK: SW1A 2AA */\r\n  \u0027US\u0027: /^\\d{5}(-\\d{4})?$/,                              /* USA: 12345 or 12345-6789 */\r\n  \u0027CA\u0027: /^[A-Z]\\d[A-Z]\\s?\\d[A-Z]\\d$/i,                  /* Canada: A1A 1A1 */\r\n  \u0027AU\u0027: /^\\d{4}$/,                                        /* Australia: 4 digits */\r\n  \u0027TR\u0027: /^\\d{5}$/,                                        /* Turkey: 5 digits */\r\n  \u0027PL\u0027: /^\\d{2}-\\d{3}$/,                                 /* Poland: 12-345 */\r\n  \u0027IT\u0027: /^\\d{5}$/,                                        /* Italy: 5 digits */\r\n  \u0027ES\u0027: /^\\d{5}$/,                                        /* Spain: 5 digits */\r\n  \u0027OTHER\u0027: /^[A-Z0-9][A-Z0-9\\s\\-]{1,9}[A-Z0-9]$/i      /* Global fallback: 3–10 alnum */\r\n};\r\nvar ZIP_PLACEHOLDER = {\r\n  \u0027DE\u0027:\u002741812\u0027,\u0027AT\u0027:\u00271010\u0027,\u0027CH\u0027:\u00278001\u0027,\u0027NL\u0027:\u00271234 AB\u0027,\u0027BE\u0027:\u00271000\u0027,\u0027FR\u0027:\u002775001\u0027,\r\n  \u0027GB\u0027:\u0027SW1A 2AA\u0027,\u0027US\u0027:\u002790210\u0027,\u0027CA\u0027:\u0027K1A 0A9\u0027,\u0027AU\u0027:\u00272000\u0027,\u0027TR\u0027:\u002734000\u0027,\r\n  \u0027PL\u0027:\u002700-001\u0027,\u0027IT\u0027:\u002700100\u0027,\u0027ES\u0027:\u002728001\u0027,\u0027OTHER\u0027:\u0027Enter postal code\u0027\r\n};\r\n\r\nfunction getZipPattern(){ return ZIP_PATTERNS[gv(\u0027p-country\u0027)] || ZIP_PATTERNS[\u0027OTHER\u0027]; }\r\n\r\nfunction liveZip(el){\r\n  var v = el.value.trim();\r\n  if(!v){ inv(\u0027p-zip\u0027,false); se(\u0027e-zip\u0027,false); so(\u0027ok-zip\u0027,false); autosave(); return; }\r\n  var ok = getZipPattern().test(v.toUpperCase());\r\n  el.classList.toggle(\u0027inv\u0027, !ok);\r\n  el.classList.toggle(\u0027ok\u0027, ok);\r\n  se(\u0027e-zip\u0027, !ok);\r\n  so(\u0027ok-zip\u0027, ok);\r\n  autosave();\r\n}\r\n\r\nfunction onCountryChange(){\r\n  var country = gv(\u0027p-country\u0027);\r\n  var ph = $(\u0027p-zip\u0027);\r\n  if(ph) ph.placeholder = ZIP_PLACEHOLDER[country] || \u0027Postal code\u0027;\r\n  /* Re-validate if already filled */\r\n  if(ph \u0026\u0026 ph.value.trim()) liveZip(ph);\r\n  autosave();\r\n}\r\n\r\n/* ── PHONE: dial-code dropdown + local number field ──\r\n   Combines selected dial code + local digits → E.164 for validation.\r\n   Local number: 5–12 digits, may start with 0 (stripped when combining). */\r\nfunction buildE164(){\r\n  var dc  = $(\u0027p-dialcode\u0027); // dial code select\r\n  var ph  = $(\u0027p-phone\u0027);    // local number input\r\n  if(!dc || !ph) return \u0027\u0027;\r\n  var code  = (dc.value||\u0027\u0027).trim();\r\n  var local = (ph.value||\u0027\u0027).replace(/[\\s\\-\\(\\)]/g,\u0027\u0027).replace(/^0+/,\u0027\u0027); // strip leading zeros\r\n  return code + local;\r\n}\r\nfunction validatePhone(){\r\n  var e164 = buildE164();\r\n  if(!e164) return false;\r\n  /* E.164: +[1-9]\\d{1,14}, total ≤16 chars including \u0027+\u0027 */\r\n  return /^\\+[1-9]\\d{6,14}$/.test(e164);\r\n}\r\nfunction livePhone(){\r\n  var ph = $(\u0027p-phone\u0027);\r\n  var v  = ph ? ph.value.trim() : \u0027\u0027;\r\n  if(!v){ ph.classList.remove(\u0027inv\u0027,\u0027ok\u0027); se(\u0027e-phone\u0027,false); so(\u0027ok-phone\u0027,false); autosave(); return; }\r\n  /* Validate: local must be 5-12 digits only */\r\n  var localOk = /^\\d[\\d\\s\\-]{4,14}$/.test(v);\r\n  ph.classList.toggle(\u0027inv\u0027, !localOk);\r\n  ph.classList.toggle(\u0027ok\u0027, localOk);\r\n  se(\u0027e-phone\u0027, !localOk);\r\n  so(\u0027ok-phone\u0027, localOk);\r\n  autosave();\r\n}\r\n\r\n/* ── AUTOSAVE — versioned, sanitised restore ── */\r\nvar saveTimer = null;\r\nfunction autosave(){\r\n  clearTimeout(saveTimer);\r\n  saveTimer = setTimeout(function(){\r\n    try{\r\n      /* SECURITY: never serialise uploadBase64 — could be MB and break localStorage quota */\r\n      var dSnap = JSON.parse(JSON.stringify(D));\r\n      delete dSnap.uploadBase64; // strip before save\r\n      delete dSnap.uploadMime;\r\n      var snap = {\r\n        v:5, svc:svc, mode:mode, D:dSnap,\r\n        fields:{\r\n          name:gv(\u0027p-name\u0027), dob:gv(\u0027p-dob\u0027), email:gv(\u0027p-email\u0027),\r\n          dialcode: ($(\u0027p-dialcode\u0027)||{}).value||\u0027+49\u0027,\r\n          phone:gv(\u0027p-phone\u0027), street:gv(\u0027p-street\u0027), city:gv(\u0027p-city\u0027),\r\n          country:gv(\u0027p-country\u0027), zip:gv(\u0027p-zip\u0027), artist:gv(\u0027p-artist\u0027),\r\n          date:gv(\u0027p-date\u0027)\r\n        }\r\n      };\r\n      localStorage.setItem(LS_KEY, JSON.stringify(snap));\r\n      var bar = $(\u0027save-bar\u0027); if(bar) bar.style.display=\u0027flex\u0027;\r\n    }catch(e){}\r\n  }, 1200);\r\n}\r\n\r\nfunction restoreAutosave(){\r\n  try{\r\n    var raw = localStorage.getItem(LS_KEY);\r\n    if(!raw) return;\r\n    var snap = JSON.parse(raw);\r\n    if(!snap || snap.v !== 5) return;\r\n    var f = snap.fields || {};\r\n    var fieldMap = {\r\n      \u0027p-name\u0027:\u0027name\u0027,\u0027p-dob\u0027:\u0027dob\u0027,\u0027p-email\u0027:\u0027email\u0027,\u0027p-phone\u0027:\u0027phone\u0027,\r\n      \u0027p-street\u0027:\u0027street\u0027,\u0027p-city\u0027:\u0027city\u0027,\u0027p-country\u0027:\u0027country\u0027,\r\n      \u0027p-zip\u0027:\u0027zip\u0027,\u0027p-artist\u0027:\u0027artist\u0027,\u0027p-date\u0027:\u0027date\u0027\r\n    };\r\n    Object.keys(fieldMap).forEach(function(id){\r\n      var el = $(id); var val = f[fieldMap[id]];\r\n      if(el \u0026\u0026 val) el.value = val;\r\n    });\r\n    /* Restore dial code separately */\r\n    if(f.dialcode){ var dc=$(\u0027p-dialcode\u0027); if(dc) dc.value=f.dialcode; }\r\n    /* Restore D state */\r\n    if(snap.D \u0026\u0026 typeof snap.D === \u0027object\u0027){\r\n      Object.keys(D).forEach(function(k){\r\n        var v = snap.D[k];\r\n        if(k===\u0027uploadBase64\u0027||k===\u0027uploadMime\u0027) return;\r\n        if(typeof D[k]===\u0027string\u0027 \u0026\u0026 typeof v===\u0027string\u0027) D[k]=v.substring(0,500);\r\n        if(Array.isArray(D[k]) \u0026\u0026 Array.isArray(v)){\r\n          D[k]=v.filter(function(x){return typeof x===\u0027string\u0027\u0026\u0026x.length\u003c200;}).slice(0,50);\r\n        }\r\n      });\r\n    }\r\n    if(snap.svc) pickSvc(snap.svc, true);\r\n    if(snap.mode) setMode(snap.mode, true);\r\n    /* Restore calendar state — MUST happen after D restore and svc pick */\r\n    if(f.dob){\r\n      var dp=f.dob.split(\u0027-\u0027);\r\n      if(dp.length===3) CAL.selDate[\u0027dob\u0027]={y:parseInt(dp[0],10),m:parseInt(dp[1],10)-1,d:parseInt(dp[2],10)};\r\n      restoreCalDisplay(\u0027dob\u0027,f.dob);\r\n    }\r\n    if(f.date){\r\n      var ap=f.date.split(\u0027-\u0027);\r\n      if(ap.length===3) CAL.selDate[\u0027appt\u0027]={y:parseInt(ap[0],10),m:parseInt(ap[1],10)-1,d:parseInt(ap[2],10)};\r\n      restoreCalDisplay(\u0027appt\u0027,f.date);\r\n    }\r\n    var bar = $(\u0027save-bar\u0027); if(bar) bar.style.display=\u0027flex\u0027;\r\n    livePhone();\r\n    var zp = $(\u0027p-zip\u0027); if(zp \u0026\u0026 zp.value) liveZip(zp);\r\n    onCountryChange();\r\n  }catch(e){}\r\n}\r\nfunction restoreCalDisplay(which, isoDate){\r\n  /* Re-render cal trigger text from a saved ISO date string */\r\n  if(!isoDate) return;\r\n  var parts = isoDate.split(\u0027-\u0027);\r\n  if(parts.length!==3) return;\r\n  var y=parseInt(parts[0],10), m=parseInt(parts[1],10)-1, d=parseInt(parts[2],10);\r\n  var months=[\u0027January\u0027,\u0027February\u0027,\u0027March\u0027,\u0027April\u0027,\u0027May\u0027,\u0027June\u0027,\u0027July\u0027,\u0027August\u0027,\u0027September\u0027,\u0027October\u0027,\u0027November\u0027,\u0027December\u0027];\r\n  var display = d+\u0027 \u0027+months[m]+\u0027 \u0027+y;\r\n  var triggerId = which===\u0027dob\u0027 ? \u0027dob-trigger\u0027 : \u0027appt-trigger\u0027;\r\n  var displayId = which===\u0027dob\u0027 ? \u0027dob-display\u0027 : \u0027appt-display\u0027;\r\n  var trig=$(triggerId), disp=$(displayId);\r\n  if(trig) trig.classList.add(\u0027ok\u0027);\r\n  if(disp){ disp.textContent=display; disp.classList.remove(\u0027cal-placeholder\u0027); }\r\n}\r\n\r\nfunction attachAutosave(){\r\n  document.querySelectorAll(\u0027input, select, textarea\u0027).forEach(function(el){\r\n    if(!el._asSave){\r\n      el._asSave = true;\r\n      el.addEventListener(\u0027input\u0027, autosave);\r\n      el.addEventListener(\u0027change\u0027, autosave);\r\n    }\r\n  });\r\n}\r\n\r\n/* ── MODE ── */\r\nfunction setMode(m, silent){\r\n  mode = m;\r\n  $(\u0027tab-on\u0027).classList.toggle(\u0027on\u0027, m===\u0027online\u0027);\r\n  $(\u0027tab-wi\u0027).classList.toggle(\u0027on\u0027, m===\u0027walkin\u0027);\r\n  $(\u0027wi-form\u0027).classList.toggle(\u0027hidden\u0027, m!==\u0027walkin\u0027);\r\n  $(\u0027online-form\u0027).classList.toggle(\u0027hidden\u0027, m===\u0027walkin\u0027);\r\n  if(!silent) autosave();\r\n}\r\n\r\n/* ── SERVICE PICK ── */\r\nfunction pickSvc(s, silent){\r\n  svc = s;\r\n  [\u0027tattoo\u0027,\u0027piercing\u0027,\u0027pmu\u0027].forEach(function(x){\r\n    $(\u0027sc-\u0027+x).classList.remove(\u0027sel-t\u0027,\u0027sel-p\u0027,\u0027sel-m\u0027);\r\n  });\r\n  $(\u0027sc-\u0027+s).classList.add({\u0027tattoo\u0027:\u0027sel-t\u0027,\u0027piercing\u0027:\u0027sel-p\u0027,\u0027pmu\u0027:\u0027sel-m\u0027}[s]);\r\n  se(\u0027e-svc\u0027, false);\r\n  /* Hide artist for piercing/pmu */\r\n  var af = $(\u0027artist-field\u0027);\r\n  if(af) af.style.display = (s===\u0027tattoo\u0027) ? \u0027\u0027 : \u0027none\u0027;\r\n  if(!silent) autosave();\r\n}\r\n\r\n/* ── PROGRESS ── */\r\nvar pLabels = [\r\n  [\u0027Step 1 of 4\u0027,\u0027Service \u0026 personal details\u0027],\r\n  [\u0027Step 2 of 4\u0027,\u0027Service details \u0026 preferences\u0027],\r\n  [\u0027Step 3 of 4\u0027,\u0027Placement, health \u0026 reference\u0027],\r\n  [\u0027Step 4 of 4\u0027,\u0027Book, review \u0026 confirm\u0027]\r\n];\r\nfunction updateProg(n){\r\n  for(var i=1;i\u003c=4;i++){\r\n    var pb=$(\u0027pb\u0027+i); pb.classList.remove(\u0027act\u0027,\u0027done\u0027);\r\n    if(i\u003cn) pb.classList.add(\u0027done\u0027);\r\n    else if(i===n) pb.classList.add(\u0027act\u0027);\r\n  }\r\n  st($(\u0027pstep\u0027), pLabels[n-1][0]);\r\n  st($(\u0027pname\u0027), pLabels[n-1][1]);\r\n}\r\n\r\n/* ── NAVIGATION ── */\r\nfunction go(n){\r\n  if(n\u003estep \u0026\u0026 !validate(step)) return;\r\n  $(\u0027step\u0027+step).classList.remove(\u0027active\u0027);\r\n  $(\u0027step\u0027+step).classList.add(\u0027hidden\u0027);\r\n  step = n;\r\n  if(step===2) injectSvcPanels();\r\n  if(step===3){ injectPlacePanels(); injectHealthChecks(); }\r\n  if(step===4) buildReview();\r\n  $(\u0027step\u0027+step).classList.remove(\u0027hidden\u0027);\r\n  $(\u0027step\u0027+step).classList.add(\u0027active\u0027);\r\n  updateProg(step);\r\n  scrollUp();\r\n  autosave();\r\n  setTimeout(attachAutosave, 100);\r\n}\r\n\r\n/* ── VALIDATION ── */\r\nfunction validate(s){\r\n  var ok = true;\r\n  if(s===1){\r\n    if(!svc){ se(\u0027e-svc\u0027,true); ok=false; } else se(\u0027e-svc\u0027,false);\r\n    var nm=gv(\u0027p-name\u0027), em=gv(\u0027p-email\u0027), db=gv(\u0027p-dob\u0027),\r\n        ph=gv(\u0027p-phone\u0027), st2=gv(\u0027p-street\u0027), ct=gv(\u0027p-city\u0027),\r\n        cn=gv(\u0027p-country\u0027), zp=gv(\u0027p-zip\u0027);\r\n    var emailOk = em \u0026\u0026 /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(em);\r\n    /* Phone: local field must have 5+ digits */\r\n    var localDigits = ph.replace(/[\\s\\-\\(\\)]/g,\u0027\u0027).replace(/^0+/,\u0027\u0027);\r\n    var phoneOk = localDigits.length \u003e= 5;\r\n    var zipOk   = zp \u0026\u0026 getZipPattern().test(zp.toUpperCase());\r\n    inv(\u0027p-name\u0027,!nm);   se(\u0027e-name\u0027,!nm);\r\n    inv(\u0027p-email\u0027,!emailOk); se(\u0027e-email\u0027,!emailOk);\r\n    /* DOB uses hidden input — highlight trigger button */\r\n    var dobTrig=$(\u0027dob-trigger\u0027);\r\n    if(dobTrig){ dobTrig.classList.toggle(\u0027inv\u0027,!db); dobTrig.classList.toggle(\u0027ok\u0027,!!db); }\r\n    se(\u0027e-dob\u0027,!db);\r\n    var ph2=$(\u0027p-phone\u0027);\r\n    if(ph2){ ph2.classList.toggle(\u0027inv\u0027,!phoneOk); ph2.classList.toggle(\u0027ok\u0027,phoneOk\u0026\u0026ph.length\u003e0); }\r\n    se(\u0027e-phone\u0027,!phoneOk); so(\u0027ok-phone\u0027,phoneOk\u0026\u0026ph.length\u003e0);\r\n    inv(\u0027p-street\u0027,!st2); se(\u0027e-street\u0027,!st2);\r\n    inv(\u0027p-city\u0027,!ct);   se(\u0027e-city\u0027,!ct);\r\n    inv(\u0027p-country\u0027,!cn); se(\u0027e-country\u0027,!cn);\r\n    inv(\u0027p-zip\u0027,!zipOk); se(\u0027e-zip\u0027,!zipOk); so(\u0027ok-zip\u0027,zipOk);\r\n    if(svc===\u0027tattoo\u0027){\r\n      var ar=gv(\u0027p-artist\u0027);\r\n      inv(\u0027p-artist\u0027,!ar); se(\u0027e-artist\u0027,!ar);\r\n      if(!ar) ok=false;\r\n    }\r\n    if(!nm||!emailOk||!db||!phoneOk||!st2||!ct||!cn||!zipOk) ok=false;\r\n  }\r\n  if(s===2){\r\n    if(svc===\u0027tattoo\u0027){\r\n      if(!D.style){ se(\u0027e-style\u0027,true); ok=false; } else se(\u0027e-style\u0027,false);\r\n      if(!D.color){ se(\u0027e-color\u0027,true); ok=false; } else se(\u0027e-color\u0027,false);\r\n      if(!D.size){  se(\u0027e-size\u0027,true);  ok=false; } else se(\u0027e-size\u0027,false);\r\n      /* p-desc is OPTIONAL — clear any stale error state if element exists */\r\n      se(\u0027e-desc\u0027,false);\r\n      var dc2=$(\u0027p-desc\u0027); if(dc2) dc2.classList.remove(\u0027inv\u0027);\r\n    }\r\n    if(svc===\u0027piercing\u0027){ var np=D.ptypes.length===0; se(\u0027e-ptypes\u0027,np); if(np) ok=false; }\r\n    if(svc===\u0027pmu\u0027){      var npm=D.pmutypes.length===0; se(\u0027e-pmutypes\u0027,npm); if(npm) ok=false; }\r\n  }\r\n  if(s===3){\r\n    /* Placement is optional — no gate */\r\n    /* Health: at least one checkbox ticked */\r\n    var ticked = document.querySelectorAll(\u0027#health-checks input[type=checkbox]:checked\u0027);\r\n    if(!ticked.length){ se(\u0027e-health\u0027,true); ok=false; } else se(\u0027e-health\u0027,false);\r\n  }\r\n  if(s===4){\r\n    var dt=gv(\u0027p-date\u0027);\r\n    var apptTrig=$(\u0027appt-trigger\u0027);\r\n    if(apptTrig){ apptTrig.classList.toggle(\u0027inv\u0027,!dt); apptTrig.classList.toggle(\u0027ok\u0027,!!dt); }\r\n    se(\u0027e-date\u0027,!dt); if(!dt) ok=false;\r\n    if(!D.consult){ se(\u0027e-consult\u0027,true); ok=false; } else se(\u0027e-consult\u0027,false);\r\n    if(!D.onSlot){  se(\u0027e-slot\u0027,true);    ok=false; } else se(\u0027e-slot\u0027,false);\r\n    var c1=$(\u0027c1\u0027).checked, c3=$(\u0027c3\u0027).checked;\r\n    if(!c1||!c3){ se(\u0027e-consent\u0027,true); ok=false; } else se(\u0027e-consent\u0027,false);\r\n  }\r\n  return ok;\r\n}\r\n\r\n/* ── CHIP HELPERS ── */\r\nfunction chipSingle(el, key){\r\n  var grp = el.closest(\u0027.chips\u0027); if(!grp) return;\r\n  grp.querySelectorAll(\u0027.chip\u0027).forEach(function(c){ c.classList.remove(\u0027on\u0027); });\r\n  el.classList.add(\u0027on\u0027);\r\n  D[key] = el.dataset.val || el.textContent.replace(/✓/g,\u0027\u0027).trim();\r\n  var par = grp.parentElement;\r\n  if(par){ var rev=par.querySelector(\u0027.reveal\u0027); if(rev\u0026\u0026!el.dataset.other) rev.classList.remove(\u0027open\u0027); }\r\n  var em={style:\u0027e-style\u0027,color:\u0027e-color\u0027,size:\u0027e-size\u0027,orient:\u0027e-orient\u0027};\r\n  if(em[key]) se(em[key], false);\r\n  autosave();\r\n}\r\nfunction chipOther(el, key, revId){\r\n  var grp = el.closest(\u0027.chips\u0027); if(!grp) return;\r\n  grp.querySelectorAll(\u0027.chip\u0027).forEach(function(c){ c.classList.remove(\u0027on\u0027); });\r\n  el.classList.add(\u0027on\u0027); D[key]=\u0027Other\u0027;\r\n  var rev=$(revId); if(rev) rev.classList.add(\u0027open\u0027);\r\n  var em={style:\u0027e-style\u0027,color:\u0027e-color\u0027,size:\u0027e-size\u0027};\r\n  if(em[key]) se(em[key], false);\r\n  autosave();\r\n}\r\nfunction chipMulti(el, arr, cls){\r\n  cls = cls||\u0027on-p\u0027;\r\n  var isOn = el.dataset.selected===\u00271\u0027;\r\n  el.dataset.selected = isOn?\u00270\u0027:\u00271\u0027;\r\n  el.classList.remove(\u0027on\u0027,\u0027on-p\u0027,\u0027on-m\u0027);\r\n  var label = el.dataset.val || el.textContent.replace(/✓/g,\u0027\u0027).trim();\r\n  if(!isOn){ el.classList.add(cls); if(D[arr].indexOf(label)===-1) D[arr].push(label); }\r\n  else{ var idx=D[arr].indexOf(label); if(idx\u003e-1) D[arr].splice(idx,1); }\r\n  var em={ptypes:\u0027e-ptypes\u0027,pmutypes:\u0027e-pmutypes\u0027};\r\n  if(em[arr]\u0026\u0026D[arr].length\u003e0) se(em[arr],false);\r\n  autosave();\r\n}\r\nfunction showCat(cat){\r\n  document.querySelectorAll(\u0027.scat-btn\u0027).forEach(function(b){ b.classList.toggle(\u0027act\u0027,b.dataset.cat===cat); });\r\n  document.querySelectorAll(\u0027.style-panel\u0027).forEach(function(p){ p.classList.remove(\u0027show\u0027); });\r\n  var p=$(\u0027sp-\u0027+cat); if(p) p.classList.add(\u0027show\u0027);\r\n}\r\n\r\n/* ── ZONE TAP ── */\r\nfunction zbp(el, label, type){\r\n  var arr = type===\u0027t\u0027?D.placements_t : type===\u0027p\u0027?D.placements_p : D.placements_m;\r\n  var hlCls = \u0027sel-\u0027+type;\r\n  var lbl = el.nextElementSibling;\r\n  var idx = arr.indexOf(label);\r\n  if(idx\u003e-1){\r\n    arr.splice(idx,1);\r\n    el.classList.remove(\u0027sel-t\u0027,\u0027sel-p\u0027,\u0027sel-m\u0027);\r\n    if(lbl\u0026\u0026lbl.tagName===\u0027text\u0027) lbl.classList.remove(\u0027sel-t\u0027,\u0027sel-p\u0027,\u0027sel-m\u0027);\r\n  }else{\r\n    arr.push(label);\r\n    el.classList.add(hlCls);\r\n    if(lbl\u0026\u0026lbl.tagName===\u0027text\u0027) lbl.classList.add(hlCls);\r\n  }\r\n  renderTags(type);\r\n  autosave();\r\n}\r\nfunction removeTag(label, type){\r\n  var arr = type===\u0027t\u0027?D.placements_t : type===\u0027p\u0027?D.placements_p : D.placements_m;\r\n  var idx = arr.indexOf(label); if(idx\u003e-1) arr.splice(idx,1);\r\n  renderTags(type);\r\n  autosave();\r\n}\r\nfunction renderTags(type){\r\n  var arr = type===\u0027t\u0027?D.placements_t : type===\u0027p\u0027?D.placements_p : D.placements_m;\r\n  var c = $(\u0027ptags-\u0027+type); if(!c) return;\r\n  while(c.firstChild) c.removeChild(c.firstChild);\r\n  if(!arr.length){\r\n    var h=document.createElement(\u0027span\u0027); h.className=\u0027place-note\u0027;\r\n    h.textContent=\u0027No areas selected — describe placement in notes if preferred\u0027;\r\n    c.appendChild(h); return;\r\n  }\r\n  arr.forEach(function(label){\r\n    var span=document.createElement(\u0027span\u0027);\r\n    span.className=\u0027ptag ptag-\u0027+type;\r\n    span.title=\u0027Click to remove\u0027;\r\n    /* Safe: textContent — no innerHTML */\r\n    span.textContent = label+\u0027 ×\u0027;\r\n    span.addEventListener(\u0027click\u0027, function(){ removeTag(label,type); });\r\n    c.appendChild(span);\r\n  });\r\n}\r\n\r\n/* ── CONSULT + SLOT ── */\r\nfunction pickConsult(el){\r\n  document.querySelectorAll(\u0027.cbtn\u0027).forEach(function(b){ b.classList.remove(\u0027on\u0027); });\r\n  el.classList.add(\u0027on\u0027); D.consult=el.dataset.val||\u0027\u0027; se(\u0027e-consult\u0027,false); autosave();\r\n}\r\nfunction pickSlot(el, which){\r\n  el.parentElement.querySelectorAll(\u0027.slotbtn\u0027).forEach(function(s){ s.classList.remove(\u0027on\u0027); });\r\n  el.classList.add(\u0027on\u0027);\r\n  var t = el.dataset.slot||el.textContent.trim();\r\n  if(which===\u0027on\u0027){ D.onSlot=t; se(\u0027e-slot\u0027,false); } else D.wiSlot=t;\r\n  autosave();\r\n}\r\n\r\n/* ── FILE UPLOAD — validates type + size, shows PDF indicator ── */\r\nfunction handleFile(input){\r\n  var f = input\u0026\u0026input.files\u0026\u0026input.files[0]; if(!f) return;\r\n  var allowed=[\u0027image/jpeg\u0027,\u0027image/png\u0027,\u0027image/webp\u0027,\u0027application/pdf\u0027];\r\n  if(allowed.indexOf(f.type)===-1){ alert(\u0027Please upload JPG, PNG, WebP or PDF only.\u0027); input.value=\u0027\u0027; return; }\r\n  if(f.size\u003e10*1024*1024){ alert(\u0027File must be under 10 MB.\u0027); input.value=\u0027\u0027; return; }\r\n\r\n  /* Reset previous upload state */\r\n  D.uploadName   = f.name;\r\n  D.uploadBase64 = \u0027\u0027;      /* BUG FIX: must store base64 so PDF can embed it */\r\n  D.uploadMime   = f.type;\r\n\r\n  $(\u0027upzone\u0027).classList.add(\u0027has\u0027);\r\n  var un=$(\u0027up-name\u0027);\r\n  un.style.display=\u0027block\u0027;\r\n  st(un, \u0027✓ \u0027+f.name);\r\n\r\n  if(f.type.startsWith(\u0027image/\u0027)){\r\n    /* Show DOM preview AND capture base64 into D for PDF */\r\n    $(\u0027pdf-pill\u0027).classList.remove(\u0027show\u0027);\r\n    var r=new FileReader();\r\n    r.onload=function(e){\r\n      var b64=e.target.result;\r\n      /* Save to state so makePDF() can call doc.addImage() */\r\n      D.uploadBase64 = b64;\r\n      var img=$(\u0027up-img\u0027);\r\n      img.src=b64;\r\n      img.style.display=\u0027block\u0027;\r\n    };\r\n    r.readAsDataURL(f);\r\n  } else if(f.type===\u0027application/pdf\u0027){\r\n    /* PDF uploads: show pill with filename — cannot embed PDF-in-PDF via jsPDF */\r\n    $(\u0027up-img\u0027).style.display=\u0027none\u0027;\r\n    D.uploadBase64 = \u0027\u0027;   /* no image to embed */\r\n    var pill=$(\u0027pdf-pill\u0027), pfname=$(\u0027pdf-fname\u0027);\r\n    st(pfname, f.name);\r\n    pill.classList.add(\u0027show\u0027);\r\n  }\r\n}\r\n\r\n/* ── INK ── */\r\n/* ink number selector removed per client request */\r\n\r\n/* ── GET VALUE (resolves \"Other\") ── */\r\nfunction getVal(key){\r\n  if(D[key]===\u0027Other\u0027){\r\n    var m={style:\u0027p-style-other\u0027,color:\u0027p-color-other\u0027,size:\u0027p-size-other\u0027};\r\n    return gv(m[key])||\u0027Other\u0027;\r\n  }\r\n  return D[key]||\u0027—\u0027;\r\n}\r\n\r\n/* ── REVIEW — pure DOM API, zero innerHTML with user data ── */\r\nfunction buildReview(){\r\n  var fi=$(\u0027finput\u0027);\r\n  var fname=(fi\u0026\u0026fi.files\u0026\u0026fi.files[0])?fi.files[0].name:\u0027Not uploaded\u0027;\r\n  var ticked=[];\r\n  document.querySelectorAll(\u0027#health-checks input[type=checkbox]:checked\u0027).forEach(function(cb){\r\n    ticked.push(cb.dataset.label||\u0027\u0027);\r\n  });\r\n  var rows=[];\r\n  rows.push({h:\u0027Personal\u0027});\r\n  rows.push([\u0027Service\u0027,{tattoo:\u0027Ta