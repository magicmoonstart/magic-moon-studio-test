erce-notes\" style=\"min-height:60px\" placeholder=\"First time? Left/right? Existing jewelry to match? Any concerns…\" maxlength=\"600\" autocomplete=\"off\" oninput=\"_H.autosave()\"\u003e\u003c/textarea\u003e\u003c/div\u003e\u003c/div\u003e`;\r\n\r\nvar PMU_HTML=`\u003cdiv class=\"card\"\u003e\u003cdiv class=\"card-hd cm\"\u003ePMU service selection \u003cspan class=\"badge badge-r\"\u003eSELECT ALL THAT APPLY\u003c/span\u003e\u003c/div\u003e\u003cp class=\"hint\"\u003eSelect by treatment zone — international PMU industry standard.\u003c/p\u003e\r\n\u003cdiv class=\"cat-hd\"\u003e👁 Brow zone\u003c/div\u003e\u003cdiv class=\"chips\"\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipMulti(this,\u0027pmutypes\u0027,\u0027on-m\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Brow Mapping / Consultation\u003c/button\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipMulti(this,\u0027pmutypes\u0027,\u0027on-m\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Microblading\u003c/button\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipMulti(this,\u0027pmutypes\u0027,\u0027on-m\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Nano Brows\u003c/button\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipMulti(this,\u0027pmutypes\u0027,\u0027on-m\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Powder Brows / Ombré\u003c/button\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipMulti(this,\u0027pmutypes\u0027,\u0027on-m\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Combo Brows (Strokes + Shading)\u003c/button\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipMulti(this,\u0027pmutypes\u0027,\u0027on-m\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Brow Correction / Reshape\u003c/button\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipMulti(this,\u0027pmutypes\u0027,\u0027on-m\u0027)\