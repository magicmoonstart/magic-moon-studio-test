r\n      var imgFmt=\u0027JPEG\u0027;\r\n      if(D.uploadMime===\u0027image/png\u0027)  imgFmt=\u0027PNG\u0027;\r\n      if(D.uploadMime===\u0027image/webp\u0027) imgFmt=\u0027WEBP\u0027;\r\n      /* Max image width = page content width, max height = 70mm */\r\n      var maxW=pw-mg*2, maxH=70;\r\n      /* Draw a light border box then embed image inside it */\r\n      y=pChk(y);\r\n      try{\r\n        /* Get natural dimensions via a temp Image to calculate aspect ratio */\r\n        var tmpImg=new Image();\r\n        tmpImg.src=D.uploadBase64;\r\n        var natW=tmpImg.naturalWidth||1, natH=tmpImg.naturalHeight||1;\r\n        var ratio=natW/natH;\r\n        var drawW=maxW, drawH=drawW/ratio;\r\n        if(drawH\u003emaxH){ drawH=maxH; drawW=drawH*ratio; }\r\n        /* Centre horizontally */\r\n        var xOff=mg+(maxW-drawW)/2;\r\n        /* Light border */\r\n        doc.setDrawColor(80,72,60);doc.setLineWidth(0.3);\r\n        doc.rect(xOff-1,y-1,drawW+2,drawH+2,\u0027S\u0027);\r\n        doc.addImage(D.uploadBase64, imgFmt, xOff, y, drawW, drawH);\r\n        y+=drawH+6;\r\n      }catch(imgErr){\r\n        /* If embed fails gracefully, just note it */\r\n        y=wrap(\u0027(Image could not be embedded — see attached file)\u0027,mg,y,pw-mg*2,6.5,txm)+3;\r\n      }\r\n    }\r\n\r\n    /* GDPR — verbatim from Terminblatt */\r\n    y=pChk(y);y=sect(\u0027DATA PROTECTION DECLARATION \u0026 CONSENT\u0027,y);\r\n    var g1=\u0027In this appointment/consent form, personal and health related information will be collected in order for us to decide whether the execution of our contracted services poses any risk to your health or may affect end results of our service. Therefore, the contract cannot be performed without this data collection. The information collected will be processed as a special category of personal data, as determined by Art. 9 of the EU-GDPR. Personal data will not be forwarded to third parties and will be stored for 10 years. Hereafter, this consent form will be destroyed.\u0027;\r\n    var g2=\u0027Photographic material of the finished piece will likely be produced. By signing this document, the client consents to the publishing of these photographs (complying to Art. 6 §1 of the EU-GDPR) for marketing purposes on our website, social media channels and print media. This consent can be withdrawn at any time (Art. 7 §3 of the EU-GDPR), in which case we will cease to use the photo material produced under this agreement.\u0027;\r\n    var g3=\u0027The health related data collected will be kept until the end of the storage period stipulated by law (10 years), as the collection of this information was legitimate up until consent withdrawal.\u0027;\r\n    y=wrap(g1,mg,y,pw-mg*2,6.5,txm)+3;y=pChk(y);\r\n    y=wrap(g2,mg,y,pw-mg*2,6.5,txm)+3;y=pChk(y);\r\n    y=wrap(g3,mg,y,pw-mg*2,6.5,txm)+6;y=pChk(y);\r\n\r\n    /* ── BUG FIX: Consent checkboxes — visible on dark background ──\r\n       Root cause 1: doc.rect(...,\u0027S\u0027) = stroke only — invisible on dark bg\r\n       Root cause 2: Unicode ✓ (U+2713) not in jsPDF Helvetica — renders blank\r\n       Fix: white filled box + gold filled box border using \u0027FD\u0027 mode,\r\n            then draw checkmark as lines (not Unicode) — works in all PDF viewers */\r\n    function drawCheckBox(bx,by,isChecked){\r\n      var bs=5; /* box size mm */\r\n      /* White filled background so it\u0027s visible on any background colour */\r\n      doc.setFillColor(255,255,255);\r\n      doc.setDrawColor(180,160,110);\r\n      doc.setLineWidth(0.4);\r\n      doc.rect(bx,by,bs,bs,\u0027FD\u0027);      /* Fill + Draw border */\r\n      if(isChecked){\r\n        /* Draw checkmark as two lines — no Unicode, works in all viewers */\r\n        doc.setDrawColor(30,120,30);    /* dark green tick */\r\n        doc.setLineWidth(0.9);\r\n        /* Left leg: bottom-left to middle-bottom */\r\n        doc.line(bx+0.8, by+bs*0.55, bx+bs*0.38, by+bs*0.82);\r\n        /* Right leg: middle-bottom to top-right */\r\n        doc.line(bx+bs*0.38, by+bs*0.82, bx+bs*0.88, by+bs*0.18);\r\n      }\r\n    }\r\n\r\n    /* Reset colours after drawCheckBox before text */\r\n    function resetColors(){\r\n      doc.setDrawColor(0,0,0);\r\n      doc.setFillColor(0,0,0);\r\n      doc.setLineWidth(0.3);\r\n    }\r\n\r\n    /* c1 — REQUIRED (always checked at this point — validate() enforces it) */\r\n    var bs=5, cx=mg, cTextX=mg+bs+3;\r\n    drawCheckBox(cx,y,true); resetColors();\r\n    y=wrap(\u0027I consent to the collection and processing of my personal and health-related data as a special category of personal data per Art. 9 EU-GDPR, stored for 10 years, not shared with third parties. This data collection is required to perform the contracted service.\u0027,cTextX,y+1,pw-cTextX-mg,6.5,tx)+5;\r\n\r\n    /* c2 — OPTIONAL (show actual state) */\r\n    y=pChk(y);\r\n    var c2checked=($(\u0027c2\u0027)\u0026\u0026$(\u0027c2\u0027).checked);\r\n    drawCheckBox(cx,y,c2checked); resetColors();\r\n    y=wrap(\u0027I consent to photographs/video of the finished result being published for marketing purposes (website, social media, print) per Art. 6 §1 EU-GDPR. Consent withdrawable at any time per Art. 7 §3. Status: \u0027+(c2checked?\u0027ACCEPTED\u0027:\u0027NOT ACCEPTED — optional\u0027),cTextX,y+1,pw-cTextX-mg,6.5,txm)+5;\r\n\r\n    /* c3 — REQUIRED (always checked) */\r\n    y=pChk(y);\r\n    drawCheckBox(cx,y,true); resetColors();\r\n    y=wrap(\u0027I confirm all information provided in this form is accurate and complete. I understand that providing false health information may affect the safety and outcome of my treatment.\u0027,cTextX,y+1,pw-cTextX-mg,6.5,tx)+10;\r\n\r\n    /* ── SIGNATURE SECTION ──\r\n       White-filled boxes visible on screen AND when printed on paper.\r\n       Three boxes: Signature (wide), Date (narrow), Studio stamp (narrow).\r\n       Boxes are white fill with a dark border — universal readability.\r\n    ── */\r\n    y=pChk(y);\r\n    var sigY = y + 6;  /* top of boxes */\r\n    var sigH = 22;     /* box height — enough space to write in */\r\n    var sigW = pw - mg*2; /* total usable width */\r\n    var boxGap = 5;\r\n\r\n    /* Calculate box widths */\r\n    var sigBoxW  = sigW * 0.52;\r\n    var dateBoxW = sigW * 0.26;\r\n    var stampBoxW= sigW - sigBoxW - dateBoxW - boxGap*2;\r\n\r\n    var sigBoxX   = mg;\r\n    var dateBoxX  = sigBoxX + sigBoxW + boxGap;\r\n    var stampBoxX = dateBoxX + dateBoxW + boxGap;\r\n\r\n    /* Draw white-fill boxes with visible dark border */\r\n    function sigBox(bx,by,bw,bh,label,sublabel){\r\n      /* White background so it shows on dark PDF and on paper */\r\n      doc.setFillColor(255,255,255);\r\n      doc.setDrawColor(80,72,60);\r\n      doc.setLineWidth(0.5);\r\n      doc.rect(bx, by, bw, bh, \u0027FD\u0027);\r\n      /* Label above box */\r\n      doc.setFontSize(6.5);\r\n      doc.setTextColor(txm[0],txm[1],txm[2]);\r\n      doc.setFont(\u0027helvetica\u0027,\u0027bold\u0027);\r\n      doc.text(label, bx, by-2);\r\n      /* Sub-label inside box bottom — light instruction text */\r\n      if(sublabel){\r\n        doc.setFontSize(5.5);\r\n        doc.setTextColor(180,168,150);\r\n        doc.setFont(\u0027helvetica\u0027,\u0027normal\u0027);\r\n        doc.text(sublabel, bx+2, by+bh-2);\r\n      }\r\n    }\r\n\r\n    t(\u0027SIGNATURES \u0026 DECLARATIONS\u0027, mg, sigY-8, 7.5, ac, \u0027left\u0027, \u0027bold\u0027);\r\n    ln(mg, sigY-6, pw-mg, sigY-6, [60,52,44], 0.25);\r\n\r\n    sigBox(sigBoxX,  sigY, sigBoxW,   sigH, \u0027CLIENT SIGNATURE\u0027, \u0027Sign here\u0027);\r\n    sigBox(dateBoxX, sigY, dateBoxW,  sigH, \u0027DATE\u0027, \u0027DD / MM / YYYY\u0027);\r\n    sigBox(stampBoxX,sigY, stampBoxW, sigH, \u0027STUDIO STAMP / INITIALS\u0027, \u0027\u0027);\r\n\r\n    y = sigY + sigH + 10;\r\n\r\n    /* Second row: witness/artist signature line (optional, for in-studio) */\r\n    y=pChk(y);\r\n    var wit2W = (sigW - boxGap) / 2;\r\n    sigBox(mg,        y, wit2W, sigH-4, \u0027ARTIST / WITNESS SIGNATURE\u0027, \u0027In-studio only\u0027);\r\n    sigBox(mg+wit2W+boxGap, y, wit2W, sigH-4, \u0027PRINTED NAME\u0027, \u0027\u0027);\r\n    y += sigH - 4 + 6;\r\n\r\n    /* Legal note below signatures */\r\n    y=pChk(y);\r\n    doc.setFontSize(6);\r\n    doc.setTextColor(txm[0],txm[1],txm[2]);\r\n    doc.setFont(\u0027helvetica\u0027,\u0027italic\u0027);\r\n    var legalNote = \u0027By signing above, the client confirms that all information provided is accurate, that they have read and understood the Data Protection Declaration above, and consent to the processing of their personal data as stated. This document is valid for in-studio and remote consultations. A copy must be retained by both parties.\u0027;\r\n    var lnLines = doc.splitTextToSize(legalNote, pw-mg*2);\r\n    doc.text(lnLines, mg, y);\r\n    y += lnLines.length * 6 * 0.44 + 4;\r\n\r\n    bg(0,ph-12,pw,12,surf);ln(0,ph-12,pw,ph-12,gold,0.3);\r\n    t(\u0027Tattooing Erkelenz · Magic Moon Studio · Customer Consultation Copy · EU-GDPR Art. 9 Compliant · Data retained 10 years\u0027,pw/2,ph-5,5.5,txm,\u0027center\u0027);\r\n\r\n    var fname=(gv(\u0027p-name\u0027).replace(/\\s+/g,\u0027_\u0027).substring(0,40)||\u0027Client\u0027);\r\n    doc.save(\u0027MyConsultation_\u0027+svc+\u0027_\u0027+fname+\u0027_\u0027+(gv(\u0027p-date\u0027)||new Date().toISOString().split(\u0027T\u0027)[0])+\u0027.pdf\u0027);\r\n    st(btn,\u0027✓ Summary Downloaded\u0027);\r\n    btn.style.borderColor=\u0027#4a8c2a\u0027; btn.style.color=\u0027#7dc46a\u0027;\r\n  }catch(err){\r\n    console.error(\u0027PDF error:\u0027,err);\r\n    st(btn,\u0027Error — try again\u0027); btn.disabled=false;\r\n  }\r\n}\r\n\r\n/* ════════════════════════════════════════════════\r\n   STATIC HTML STRINGS — developer-authored only\r\n   ZERO user data interpolated here.\r\n   insertAdjacentHTML on static strings is safe.\r\n════════════════════════════════════════════════ */\r\nvar TATTOO_HT