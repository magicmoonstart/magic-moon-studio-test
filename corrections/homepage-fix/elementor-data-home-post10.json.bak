u003c/svg\u003e\u003c/div\u003e\u003c/div\u003e\r\n\u003cdiv class=\"place-tags\" id=\"ptags-t\"\u003e\u003cspan class=\"place-note\"\u003eNo areas selected — describe placement in notes if preferred\u003c/span\u003e\u003c/div\u003e\r\n\u003cdiv class=\"cat-hd\" style=\"margin-top:12px\"\u003eOrientation\u003c/div\u003e\r\n\u003cdiv class=\"chips\"\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipSingle(this,\u0027orient\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Left side\u003c/button\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipSingle(this,\u0027orient\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Right side\u003c/button\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipSingle(this,\u0027orient\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Front\u003c/button\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipSingle(this,\u0027orient\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Back\u003c/button\u003e\u003cbutton type=\"button\" class=\"chip\" onclick=\"_H.chipSingle(this,\u0027orient\u0027)\"\u003e\u003cspan class=\"ck2\"\u003e✓\u003c/span\u003e Around (wrap)\u003c/button\u003e\u003c/div\u003e\r\n\u003c/div\u003e\r\n\u003cdiv class=\"card\"\u003e\u003cdiv class=\"card-hd ct\"\u003eSkin Notes \u003cspan class=\"badge badge-o\"\u003eOPTIONAL\u003c/span\u003e\u003c/div\u003e\u003cp class=\"hint\"\u003eNote any ink allergies or skin conditions your artist should know about.\u003c/p\u003e\r\n\u003cdiv class=\"g2 mt8\"\u003e\u003cdiv class=\"f\"\u003e\u003clabel\u003eInk allergies\u003c/label\u003e\u003cinput type=\"text\" id=\"p-inkallergy\" placeholder=\"e.g. red pigment, or \u0027none\u0027\" maxlength=\"200\" autocomplete=\"off\" oninput=\"_H.autosave()\"\u003e\u003c/div\u003e\r\n\u003cdiv class=\"f\"\u003e\u003clabel\u003eSkin conditions\u003c/label\u003e\u003cinput type=\"text\" id=\"p-skin\" placeholder=\"e.g. eczema, or \u0027none\u0027\" maxlength=\"200\" autocomplete=\"off\" oninput=\"_H.autosave()\"\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e`;\r\n\r\nvar PLACE_PIERCING_HTML=`\u003cdiv class=\"card\"\u003e\u003cdiv class=\"card-hd cp\"\u003ePiercing placement \u003cspan class=\"badge badge-g\"\u003eOPTIONAL — tap to mark\u003c/span\u003e\u003c/div\u003e\u003cdiv class=\"tap-hint\"\u003eTap zones on the ear and face diagrams to indicate preferred placement.\u003c/div\u003e\r\n\u003cdiv class=\"diag-wrap\"\u003e\r\n\u003cdiv class=\"diag-col\"\u003e\u003cdiv class=\"diag-lbl\" style=\"color:rgba(94,196,232,.6)\"\u003eEar anatomy\u003c/div\u003e\r\n\u003csvg class=\"svg-diagram\" viewBox=\"0 0 140 200\" style=\"max-width:160px\" xmlns=\"http://www.w3.org/2000/svg\"\u003e\r\n\u003cpath class=\"sk\" d=\"M35,30 Q22,62 26,104 Q28,146 46,163 Q62,178 84,167 Q107,154 111,120 Q116,86 103,56 Q90,28 66,20 Q48,14 35,30\"/\u003e\r\n\u003cpath class=\"pz\" d=\"M42,140 Q54,158 70,161 Q86,161 90,149 Q85,133 70,130 Q54,128 42,140 Z\" onclick=\"_H.zbp(this,\u0027Earlobe\u0027,\u0027p\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"66\" y=\"149\"\u003eLOBE\u003c/text\u003e\r\n\u003cpath class=\"pz\" d=\"M42,120 Q54,130 70,130 Q86,130 90,120 Q85,109 70,107 Q55,107 42,120 Z\" onclick=\"_H.zbp(this,\u0027Upper Lobe\u0027,\u0027p\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"66\" y=\"121\"\u003eUP.LOBE\u003c/text\u003e\r\n\u003cpath class=\"pz\" d=\"M62,21 Q78,18 96,33 Q106,50 104,70 Q93,58 78,54 Q66,51 60,40 Z\" onclick=\"_H.zbp(this,\u0027Helix\u0027,\u0027p\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"83\" y=\"47\"\u003eHELIX\u003c/text\u003e\r\n\u003cpath class=\"pz\" d=\"M35,30 Q44,20 62,21 Q60,40 52,48 Q40,45 33,37 Z\" onclick=\"_H.zbp(this,\u0027Forward Helix\u0027,\u0027p\u0027)\"/\u003e\u003ctext class=\"bl\" x=\"47\" y=\"37\"\u003eF.HELIX\u003c/text\u003e\r\n\u003cpath class=\"pz\" d=\"M35,56 Q45,48 60,51 Q60,63 53,69 Q41,67 35,57 Z\" onclick=\"_H.zbp(this,\u0027Flat\u0027,\u0027p\u0027)\"/\u003e